# Frontend environment template — copy to .env.local
# Vite proxies /api/* to http://localhost:5000 in dev (see vite.config.js).
# VITE_API_URL="http://localhost:5000"

# Cloudflare Turnstile site key. The login page also reads the public site key
# from GET /api/auth/login-config, so a backend TURNSTILE_SITE_KEY can be used
# without rebuilding. Leave both blank to hide the widget in development.
VITE_TURNSTILE_SITE_KEY=""
