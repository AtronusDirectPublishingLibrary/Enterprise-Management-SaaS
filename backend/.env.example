# Backend environment template — copy to .env and fill in real values.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ethiobiopharma?schema=public"
PORT=5000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"
JWT_SECRET="REPLACE-WITH-48-BYTE-RANDOM-HEX"
JWT_EXPIRES="8h"


# Public site origin used in alert email links
APP_URL="http://localhost:5173"

# Outgoing email for plan target and reporting-deadline alerts (any SMTP provider).
# Leave SMTP_HOST empty to keep alerts in-app only.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Ethio-Biopharma Plans <plans@ethiobiopharma.et>"

# Google Analytics 4 visitor counter (optional).
# The measurement id (G-XXXXXXX) and the numeric property id are entered in
# Admin → Public Site; only the read-only service-account key lives here.
# Without it the counter reports the app's own visit log instead.
GA4_CLIENT_EMAIL=""
GA4_PRIVATE_KEY=""

# Extra recipients (comma separated); owners and admins are added automatically.
PLAN_ALERT_EMAILS=""
PLAN_ALERTS_AUTORUN=true
PLAN_ALERT_INTERVAL_HOURS=6

# --- Governance & security (optional) -------------------------------------
# Audit-log retention in days. The server prunes older entries daily; set 0 to
# keep everything. `npm run audit:prune` runs the same job on demand.
AUDIT_RETENTION_DAYS=365
AUDIT_RETENTION_AUTORUN=true

# Scheduled consolidated-report delivery. The server checks due schedules every
# 15 minutes when this is not "false". Requires the SMTP settings above.
REPORT_SCHEDULES_AUTORUN=true
APP_PUBLIC_URL="http://localhost:5173"

# --- Operational resilience ------------------------------------------------
# The readiness probe is GET /api/ready (database check); /api/health is a
# process liveness check only. These bound slow or stalled HTTP clients.
REQUEST_TIMEOUT_MS=30000
HEADERS_TIMEOUT_MS=35000
KEEP_ALIVE_TIMEOUT_MS=65000

# --- Two-factor enforcement ------------------------------------------------
# Production defaults to required unless MFA_ENFORCEMENT is set to optional or
# off. Development defaults to optional. The roles/positions below must enroll
# before they can use anything except their account-security endpoints.
MFA_ENFORCEMENT=""
MFA_REQUIRED_ROLES="admin,executive"
MFA_REQUIRED_POSITIONS="Chief Executive Officer,Strategy and Planning Officer,Human Resource and Administration Manager,Finance Manager,Finance Officer,Internal Audit Officer,IT Officer"

# --- Passkeys / WebAuthn (optional, production) ----------------------------
# Password + authenticator app remains available as the fallback. The origin
# must be the exact browser origin (HTTPS in production), and the RP ID is its
# hostname. Leave PASSKEYS_ENABLED empty to auto-enable in production when these
# values are present; set false to disable explicitly.
PASSKEYS_ENABLED=""
WEBAUTHN_RP_ID=""
WEBAUTHN_ORIGIN=""
WEBAUTHN_RP_NAME="Ethio-Biopharma EB-EMS"

# --- Upload malware screening (optional) ----------------------------------
# ClamAV daemon address. Leave CLAMAV_HOST empty to keep scanning disabled.
# In production set UPLOAD_SCAN_REQUIRED=true so uploads are refused when the
# scanner is unavailable, rather than silently accepted.
CLAMAV_HOST=""
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=60000
UPLOAD_SCAN_REQUIRED=false

# Backup script (`npm run backup`). Backups live in backend/backups/ and are
# pruned after BACKUP_RETENTION_DAYS. Install PostgreSQL client tools for a
# full pg_dump SQL backup; otherwise a JSON table export is written.
BACKUP_DIR="backups"
BACKUP_RETENTION_DAYS=30

# --- Fleet cost control ----------------------------------------------------
# No credentials are required. Fuel, maintenance, parts and tyre costs are
# stored in PostgreSQL and analysed per vehicle in Fleet → Cost control.

# --- Public homepage QR ----------------------------------------------------
# The QR is generated by the API with the EBPE mark at its centre. Set this to
# the public homepage that a phone should open. Falls back to APP_ORIGIN.
PUBLIC_SITE_URL="http://localhost:5173"

# --- Automatic social distribution of news --------------------------------
# Configure only the destinations you use. A destination without credentials
# is recorded as SKIPPED, so queued posts never loop forever.
FACEBOOK_PAGE_ID=""
FACEBOOK_PAGE_ACCESS_TOKEN=""
LINKEDIN_ACCESS_TOKEN=""
LINKEDIN_AUTHOR_URN=""
X_BEARER_TOKEN=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# Generic endpoint for Buffer, Make, Zapier or an internal social gateway.
SOCIAL_WEBHOOK_URL=""
# Set to false to stop the periodic social queue worker.
SOCIAL_AUTORUN=true

# --- AI decision brief (optional) -----------------------------------------
# The Executive BI and consolidated reports always produce a deterministic
# insight brief. Set AI_PROVIDER=openai to refine its wording with a model.
# Without a key, no data leaves the application.
AI_PROVIDER=""
OPENAI_API_KEY=""
AI_MODEL="gpt-4o-mini"
AI_API_URL="https://api.openai.com/v1"

# --- Login CAPTCHA (Cloudflare Turnstile) ---------------------------------
# Production is fail-closed: startup refuses without TURNSTILE_SECRET_KEY.
# Set TURNSTILE_ENABLED=false only for a documented exception. The site key is
# public and is also returned by GET /api/auth/login-config; set it here and/or
# VITE_TURNSTILE_SITE_KEY in the frontend build.
TURNSTILE_ENABLED=""
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
# Exact hostname(s) allowed in the siteverify response. Falls back to the
# hostnames in CORS_ORIGIN/APP_PUBLIC_URL when omitted.
TURNSTILE_ALLOWED_HOSTNAMES=""
TURNSTILE_ACTION="login"
TURNSTILE_MAX_AGE_SECONDS=300

# --- Audit evidence export ------------------------------------------------
# Required for GET /api/audit/export. Keep the value in the server secret store.
AUDIT_EXPORT_SIGNING_KEY=""
AUDIT_EXPORT_KEY_ID="2026-primary"

# Ed25519 checkpoint key. Generate with:
#   openssl genpkey -algorithm ED25519 -out audit-checkpoint.pem
# Put the PEM contents here (literal newlines or \n escapes). The public key is
# stored with each checkpoint; keep the private key out of the database, source
# control and backups. Without it, checkpoints stay disabled.
AUDIT_CHECKPOINT_PRIVATE_KEY=""
AUDIT_CHECKPOINT_KEY_ID="2026-primary"
AUDIT_CHECKPOINT_AUTORUN=true

# Set only when a known reverse proxy terminates TLS in front of the API.
TRUST_PROXY="false"
