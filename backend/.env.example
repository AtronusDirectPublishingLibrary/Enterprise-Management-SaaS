# Backend environment template — copy to .env and fill in real values.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ethiobiopharma?schema=public"
PORT=5000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"
JWT_SECRET="REPLACE-WITH-48-BYTE-RANDOM-HEX"
JWT_EXPIRES="8h"


# Public site origin used in alert email links
APP_URL="http://localhost:5173"

# Outgoing email for plan target and reporting-deadline alerts (any SMTP provider).
# Leave SMTP_HOST empty to keep alerts in-app only.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Ethio-Biopharma Plans <plans@ethiobiopharma.et>"

# Google Analytics 4 visitor counter (optional).
# The measurement id (G-XXXXXXX) and the numeric property id are entered in
# Admin → Public Site; only the read-only service-account key lives here.
# Without it the counter reports the app's own visit log instead.
GA4_CLIENT_EMAIL=""
GA4_PRIVATE_KEY=""

# Extra recipients (comma separated); owners and admins are added automatically.
PLAN_ALERT_EMAILS=""
PLAN_ALERTS_AUTORUN=true
PLAN_ALERT_INTERVAL_HOURS=6

# --- Governance & security (optional) -------------------------------------
# Audit-log retention in days. The server prunes older entries daily; set 0 to
# keep everything. `npm run audit:prune` runs the same job on demand.
AUDIT_RETENTION_DAYS=365
AUDIT_RETENTION_AUTORUN=true

# Scheduled consolidated-report delivery. The server checks due schedules every
# 15 minutes when this is not "false". Requires the SMTP settings above.
REPORT_SCHEDULES_AUTORUN=true
APP_PUBLIC_URL="http://localhost:5173"

# Backup script (`npm run backup`). Backups live in backend/backups/ and are
# pruned after BACKUP_RETENTION_DAYS. Install PostgreSQL client tools for a
# full pg_dump SQL backup; otherwise a JSON table export is written.
BACKUP_DIR="backups"
BACKUP_RETENTION_DAYS=30
