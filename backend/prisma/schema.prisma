generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id               String    @id @default(cuid())
  projectId        String    @unique
  title            String
  description      String?
  sourceOfFunds    String
  startDate        DateTime
  endDate          DateTime
  status           String    @default("Not Started")
  priority         String    @default("Medium")
  progress         Int       @default(0)
  createdBy        String
  dependencies     String?

  createdDate      DateTime  @default(now())
  lastModifiedBy   String?
  lastModifiedDate DateTime?
  projectCategory  String?
  leadDirectorate  String?
  leadDivision     String?
  piName           String?
  piEmail          String?
  projectManager   String?

  workPackages WorkPackage[]
  brief            ProjectBrief?
  members          ProjectMember[]
  messages         ProjectMessage[]
  automationRules  AutomationRule[]
  goals            ProjectGoal[]
  timeEntries      TimeEntry[]
  milestones   Milestone[]
  activities   Activity[]

  @@map("Project")
}

model WorkPackage {
  id               String    @id @default(cuid())
  projectId        String
  workPackageId    String    @unique
  title            String
  description      String?
  startDate        DateTime
  endDate          DateTime
  progress         Int       @default(0)
  status           String    @default("Not Started")
  createdBy        String
  dependencies     String?

  createdDate      DateTime  @default(now())
  lastModifiedBy   String?
  lastModifiedDate DateTime?

  project    Project    @relation(fields: [projectId], references: [projectId], onDelete: Cascade)
  activities Activity[]

  @@map("WorkPackage")
}

model Milestone {
  id               String    @id @default(cuid())
  projectId        String
  milestoneId      String    @unique
  title            String
  description      String?
  startDate        DateTime
  endDate          DateTime
  progress         Int       @default(0)
  status           String    @default("Not Started")
  createdBy        String
  dependencies     String?

  createdDate      DateTime  @default(now())
  lastModifiedBy   String?
  lastModifiedDate DateTime?

  // Self-relation for Milestone Dependencies
  predecessors Milestone[] @relation("MilestoneDependencies")
  successors   Milestone[] @relation("MilestoneDependencies")

  project Project @relation(fields: [projectId], references: [projectId], onDelete: Cascade)
  @@map("Milestone")
}

model Activity {
  id                String    @id @default(cuid())
  projectId         String
  workPackageId     String?
  parentActivityId  String?
  milestoneId       String?
  activityId        String    @unique
  title             String
  description       String?
  startDate         DateTime
  endDate           DateTime
  duration          Int?
  progress          Int       @default(0)
  assignedTo        String?
  status            String    @default("Not Started")
  financialPlan     Decimal   @default(0) @db.Decimal(14,2)
  actualExpenditure Decimal   @default(0) @db.Decimal(14,2)
  createdBy         String
  dependencies     String?

  createdDate       DateTime  @default(now())
  lastModifiedBy    String?
  lastModifiedDate  DateTime?

  project     Project      @relation(fields: [projectId], references: [projectId], onDelete: Cascade)
  workPackage WorkPackage? @relation(fields: [workPackageId], references: [workPackageId], onDelete: SetNull)
  parent      Activity?    @relation("ActivityTree", fields: [parentActivityId], references: [activityId], onDelete: Cascade)
  children    Activity[]   @relation("ActivityTree")

  // Self-relation for Activity Dependencies
  predecessors Activity[] @relation("ActivityDependencies")
  successors   Activity[] @relation("ActivityDependencies")

  @@map("Activity")
}

model User {
  id                  String    @id @default(cuid())
  firstName           String?   @map("first_name")
  lastName            String?   @map("last_name")
  username            String    @unique
  passwordHash        String    @map("password_hash")
  role                String    @default("viewer")
  associatedGrants    String[]  @default([]) @map("associated_grants")
  assignedDirectorate String?   @map("assigned_directorate")
  assignedDivision    String?   @map("assigned_division")
  piName              String?   @map("pi_name")
  coPiName            String?   @map("co_pi_name")
  email               String?
  lastLogin           DateTime? @map("last_login")
  createdDate         DateTime  @default(now()) @map("created_date")
  forceChange         Boolean   @default(false) @map("force_change")
  @@map("users")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  timestamp DateTime @default(now())
  grantId   String?  @map("grant_id")
  action    String
  user      String
  details   Json?
  @@map("audit_log")
}

model Document {
  id                String   @id @default(cuid())
  title             String
  docNumber         String?  @map("doc_number")
  thematic          String
  thematicOther     String?  @map("thematic_other")
  type              String
  typeOther         String?  @map("type_other")
  unit              String?
  language          String   @default("English")
  version           String?
  firstEndorsement  String?  @map("first_endorsement")
  recentRenewal     String?  @map("recent_renewal")
  expiry            String?
  status            String   @default("Active")
  notes             String?
  fileName          String?  @map("file_name")
  fileUrl           String?  @map("file_url")
  uploadedBy        String?  @map("uploaded_by")
  uploadDate        DateTime @default(now()) @map("upload_date")
  folderPath        String?  @map("folder_path")

  @@map("Document")
}

model HeroImage {
  id        String   @id @default(cuid())
  url       String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("HeroImage")
}

model HeroText {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("HeroText")
}

model DropdownOption {
  id        String   @id @default(cuid())
  category  String
  value     String
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([category, value])
  @@map("DropdownOption")
}
