  phone           String?
  source          String?
  stage           String     @default("APPLIED") // APPLIED | SCREENING | INTERVIEW | OFFER | HIRED | REJECTED | ON_HOLD
  rating          Int?
  notes           String?
  coverLetter     String?
  resumeUrl       String?
  interviewAt     DateTime?
  rejectionReason String?
