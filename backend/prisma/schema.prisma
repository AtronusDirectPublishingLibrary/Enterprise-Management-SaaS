  @@unique([userId, year])
  @@index([tenantId])
}

model AnnualLeavePlanItem {
  tenantId  String?  @map("tenant_id")
  id        String   @id @default(cuid())
  planId    String
  startDate DateTime
  endDate   DateTime
  days      Int
  leaveType String   @default("ANNUAL")
  notes     String?

  plan AnnualLeavePlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// --- PUBLIC HOLIDAYS MODEL ---
model PublicHoliday {
  tenantId  String?  @map("tenant_id")
  id        String   @id @default(cuid())
  name      String
  date      DateTime @unique
  year      Int // Ethiopian Fiscal Year or Gregorian Year depending on preference
  createdAt DateTime @default(now())

  @@index([tenantId])
}

// --- TIMESHEET MODELS ---

model Timesheet {
  tenantId        String?   @map("tenant_id")
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation("UserTimesheets", fields: [userId], references: [id], onDelete: Cascade)
  month           Int // 1-12
  year            Int
  status          String    @default("DRAFT") // DRAFT | SUBMITTED | FORWARDED | APPROVED | REJECTED
  supervisorId    String?
  supervisor      User?     @relation("TimesheetSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  rejectionReason String?
  submittedAt     DateTime?
  hrReviewedAt    DateTime? @map("hr_reviewed_at")
  hrReviewedBy    String?   @map("hr_reviewed_by")
  approvedAt      DateTime?
  createdAt       DateTime  @default(now())

  entries TimesheetEntry[]

