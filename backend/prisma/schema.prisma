generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  tenantId      String?  @map("tenant_id")
  id            String   @id @default(cuid())
  projectId     String   @unique
  title         String
  description   String?
  sourceOfFunds String
  startDate     DateTime
  endDate       DateTime
  status        String   @default("Not Started")
  priority      String   @default("Medium")
  progress      Int      @default(0)
  createdBy     String
  dependencies  String?

  createdDate      DateTime  @default(now())
  lastModifiedBy   String?
  lastModifiedDate DateTime?
  projectCategory  String?
  leadDepartment   String?
  leadDivision     String?
  piName           String?
  piEmail          String?
  projectManager   String?
  // The plan period whose financial targets this project delivers. PMS
  // financial plans are consolidated into the AOP/Strategic plan, so the
  // portfolio roll-up reads money from the plan and only actuals from PMS.
  planId           String?   @map("plan_id")

  workPackages    WorkPackage[]
  documents       Document[]
  brief           ProjectBrief?
  members         ProjectMember[]
  messages        ProjectMessage[]
  automationRules AutomationRule[]
  goals           ProjectGoal[]
  timeEntries     TimeEntry[]
  milestones      Milestone[]
  activities      Activity[]
  plan            Plan?            @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([planId])
  @@map("Project")
}

model WorkPackage {
  tenantId      String?  @map("tenant_id")
  id            String   @id @default(cuid())
  projectId     String
  workPackageId String   @unique
  title         String
  description   String?
  startDate     DateTime
  endDate       DateTime
  progress      Int      @default(0)
  status        String   @default("Not Started")
  createdBy     String
  dependencies  String?
  // Username of the project-team member accountable for delivery.
  ownerUsername String?  @map("owner_username")
  ownerName     String?  @map("owner_name")

  createdDate      DateTime  @default(now())
  lastModifiedBy   String?
  lastModifiedDate DateTime?

  project    Project    @relation(fields: [projectId], references: [projectId], onDelete: Cascade)
  activities Activity[]

  @@index([tenantId])
  @@map("WorkPackage")
}

model Milestone {
  tenantId     String?  @map("tenant_id")
  id           String   @id @default(cuid())
  projectId    String
  milestoneId  String   @unique
  title        String
  description  String?
  startDate    DateTime
  endDate      DateTime
  progress     Int      @default(0)
  status       String   @default("Not Started")
  createdBy    String
  dependencies String?

  createdDate      DateTime  @default(now())
  lastModifiedBy   String?
  lastModifiedDate DateTime?

  // Self-relation for Milestone Dependencies
  predecessors Milestone[] @relation("MilestoneDependencies")
  successors   Milestone[] @relation("MilestoneDependencies")

  project Project @relation(fields: [projectId], references: [projectId], onDelete: Cascade)

  @@index([tenantId])
  @@map("Milestone")
}

model Activity {
  tenantId          String?  @map("tenant_id")
  id                String   @id @default(cuid())
  projectId         String
  workPackageId     String?
  parentActivityId  String?
  milestoneId       String?
  activityId        String   @unique
  title             String
  description       String?
  startDate         DateTime
  endDate           DateTime
  duration          Int?
  progress          Int      @default(0)
  assignedTo        String?
  status            String   @default("Not Started")
  financialPlan     Decimal  @default(0) @db.Decimal(14, 2)
  actualExpenditure Decimal  @default(0) @db.Decimal(14, 2)
  createdBy         String
  dependencies      String?

  createdDate      DateTime  @default(now())
  lastModifiedBy   String?
  lastModifiedDate DateTime?

  project     Project      @relation(fields: [projectId], references: [projectId], onDelete: Cascade)
  workPackage WorkPackage? @relation(fields: [workPackageId], references: [workPackageId], onDelete: SetNull)
  parent      Activity?    @relation("ActivityTree", fields: [parentActivityId], references: [activityId], onDelete: Cascade)
  children    Activity[]   @relation("ActivityTree")

  // Self-relation for Activity Dependencies
  predecessors Activity[] @relation("ActivityDependencies")
  successors   Activity[] @relation("ActivityDependencies")

  @@index([tenantId])
  @@map("Activity")
}

model User {
  id                  String    @id @default(cuid())
  // Multi-tenant scope. Backfilled to the default tenant in S2.
  tenantId            String    @map("tenant_id")
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  isTenantAdmin       Boolean   @default(false) @map("is_tenant_admin")
  isPlatformAdmin     Boolean   @default(false) @map("is_platform_admin")
  firstName           String?   @map("first_name")
  lastName            String?   @map("last_name")
  username            String    @unique
  passwordHash        String    @map("password_hash")
  role                String    @default("viewer")
  associatedGrants    String[]  @default([]) @map("associated_grants")
  department          String?   @map("department")
  subDepartment       String?   @map("sub_department")
  piName              String?   @map("pi_name")
  coPiName            String?   @map("co_pi_name")
  email               String?
  lastLogin           DateTime? @map("last_login")
  tokenVersion        Int       @default(0) @map("token_version")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  lastFailedLoginAt   DateTime? @map("last_failed_login_at")
  createdDate         DateTime  @default(now()) @map("created_date")
  forceChange         Boolean   @default(false) @map("force_change")
  mfaEnabled          Boolean   @default(false) @map("mfa_enabled")
  mfaSecret           String?   @map("mfa_secret")
  // Staff self-service profile
  profession          String?
  requiresLicence     Boolean   @default(false) @map("requires_licence")
  profileCompletedAt  DateTime? @map("profile_completed_at")
  // Optional e-signature assets. A typed name is always accepted at signing;
  // these images are stamped onto signed records when the person has uploaded them.
  signatureUrl        String?   @map("signature_url")
  initialsUrl         String?   @map("initials_url")
  initialsText        String?   @map("initials_text")
  signatureUpdatedAt  DateTime? @map("signature_updated_at")
  avatarUrl           String?   @map("avatar_url")
  avatarUpdatedAt     DateTime? @map("avatar_updated_at")
  employeeNo          String?   @unique @map("employee_no")
  jobTitle            String?   @map("job_title")
  // Canonical position from the HR position list (or a free-text "Other" value).
  position            String?   @map("position")
  phone               String?
  hireDate            DateTime? @map("hire_date")
  probationEnd        DateTime? @map("probation_end")
  contractEnd         DateTime? @map("contract_end")
  // Regular | Contract | Part-time | Other: <specify>
  employmentType      String?   @map("employment_type")
  // HR Utility relations

  immediateSupervisorId String? @map("immediate_supervisor_id")
  immediateSupervisor   User?   @relation("UserSupervisor", fields: [immediateSupervisorId], references: [id], onDelete: SetNull)
  directReports         User[]  @relation("UserSupervisor")

  trainingRecords        Training[]     @relation("UserTraining")
  leaveRequestsMade      LeaveRequest[] @relation("LeaveRequester")
  leaveRequestsToApprove LeaveRequest[] @relation("LeaveSupervisor")
  leaveRequestsApproved  LeaveRequest[] @relation("LeaveApprover")

  attendanceLogs AttendanceLog[] @relation("UserAttendance")
  LeaveBalance   LeaveBalance[]

  annualPlans    AnnualLeavePlan[] @relation("UserAnnualPlans")
  plansToApprove AnnualLeavePlan[] @relation("PlanSupervisor")

  // Timesheet relations
  timesheets          Timesheet[]    @relation("UserTimesheets")
  timesheetsToApprove Timesheet[]    @relation("TimesheetSupervisor")
  salaryRecords       SalaryRecord[]
  payslips            Payslip[]

  staffTasks     StaffTask[]     @relation("UserStaffTasks")
  staffDocuments StaffDocument[] @relation("UserStaffDocuments")
  inductions     Induction[]     @relation("UserInduction")
  appraisals     Appraisal[]     @relation("UserAppraisals")

  signatures              SignatureRecord[]          @relation("UserSignatures")
  jobDescriptionUploads   JobDescription[]           @relation("JobDescriptionUploader")
  jobDescriptions         JobDescriptionAssignment[] @relation("UserJobDescriptions")
  jobDescriptionsAssigned JobDescriptionAssignment[] @relation("JobDescriptionAssigner")
  recruitmentRequests     RecruitmentRequest[]       @relation("RecruitmentRequester")
  recruitmentApprovals    RecruitmentRequest[]       @relation("RecruitmentApprover")
  offboardingCases        OffboardingCase[]          @relation("UserOffboarding")
  offboardingInitiated    OffboardingCase[]          @relation("OffboardingInitiator")
  offboardingManaged      OffboardingCase[]          @relation("OffboardingManager")

  // Fleet & transport
  vehicleRequestsMade          VehicleRequest[] @relation("VehicleRequester")
  vehicleRequestsToApprove     VehicleRequest[] @relation("VehicleRequestSupervisor")
  vehicleRequestsFleetApproved VehicleRequest[] @relation("VehicleRequestFleetApprover")
  rideRequestsMade             RideRequest[]    @relation("RideRequester")
  rideRequestsToApprove        RideRequest[]    @relation("RideSupervisor")
  rideRequestsApproved         RideRequest[]    @relation("RideApprover")
  driverProfile                Driver?          @relation("DriverUser")

  // QMS document control
  qmsDocumentsOwned    QmsDocument[] @relation("QmsDocumentOwner")
  qmsDocumentsReviewed QmsDocument[] @relation("QmsDocumentReviewer")
  qmsDocumentsApproved QmsDocument[] @relation("QmsDocumentApprover")

  // QMS quality events and improvements
  qmsDeviationsReported QmsDeviation[]     @relation("QmsDeviationReporter")
  qmsDeviationsOwned    QmsDeviation[]     @relation("QmsDeviationOwner")
  qmsDeviationsClosed   QmsDeviation[]     @relation("QmsDeviationCloser")
  qmsCapasOwned         QmsCapa[]          @relation("QmsCapaOwner")
  qmsCapasVerified      QmsCapa[]          @relation("QmsCapaVerifier")
  qmsChangesOwned       QmsChangeControl[] @relation("QmsChangeOwner")
  qmsChangesApproved    QmsChangeControl[] @relation("QmsChangeApprover")

  mfaRecoveryCodes    MfaRecoveryCode[]    @relation("UserRecoveryCodes")
  webauthnCredentials WebAuthnCredential[] @relation("UserWebAuthnCredentials")

  @@map("users")
}

// One-time recovery codes are stored as SHA-256 digests. The plaintext is
// returned exactly once at generation time and is never readable afterwards.
model MfaRecoveryCode {
  tenantId  String?   @map("tenant_id")
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation("UserRecoveryCodes", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@index([userId, usedAt])
  @@index([tenantId])
  @@map("mfa_recovery_code")
}

// Registered WebAuthn/passkey credentials. Public keys are base64url encoded;
// the private key never leaves the authenticator.
model WebAuthnCredential {
  tenantId     String?   @map("tenant_id")
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  credentialId String    @unique @map("credential_id")
  publicKey    String    @map("public_key")
  counter      Int       @default(0)
  transports   String[]  @default([])
  deviceType   String    @default("singleDevice") @map("device_type")
  backedUp     Boolean   @default(false) @map("backed_up")
  name         String?
  createdAt    DateTime  @default(now()) @map("created_at")
  lastUsedAt   DateTime? @map("last_used_at")
  user         User      @relation("UserWebAuthnCredentials", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@map("webauthn_credential")
}

// Short-lived challenges with an opaque id returned to the browser. Storing
// them server-side prevents a client from choosing or replaying a challenge.
model WebAuthnChallenge {
  tenantId  String?  @map("tenant_id")
  id        String   @id @default(cuid())
  challenge String   @unique
  userId    String?  @map("user_id")
  kind      String
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@index([tenantId])
  @@map("webauthn_challenge")
}

model AuditLog {
  id           BigInt   @id @default(autoincrement())
  timestamp    DateTime @default(now())
  // Tenant scope. Null for pre-SaaS legacy rows and platform-level events.
  tenantId     String?  @map("tenant_id")
  grantId      String?  @map("grant_id")
  action       String
  user         String
  details      Json?
  // Hash-chain fields. Nullable only for legacy rows awaiting backfill; every
  // new entry is written with all four values.
  nonce        String?
  chainVersion Int      @default(1) @map("chain_version")
  eventHash    String?  @map("event_hash")
  prevHash     String?  @map("prev_hash")

  @@unique([eventHash])
  @@unique([prevHash])
  @@index([tenantId, timestamp])
  @@map("audit_log")
}

model AuditVerification {
  tenantId     String?  @map("tenant_id")
  id           BigInt   @id @default(autoincrement())
  checkedAt    DateTime @default(now()) @map("checked_at")
  checkedBy    String   @map("checked_by")
  checkedCount Int      @map("checked_count")
  valid        Boolean
  brokenAt     BigInt?  @map("broken_at")
  headHash     String?  @map("head_hash")
  legacyCount  Int      @default(0) @map("legacy_count")
  truncated    Boolean  @default(false)

  @@index([checkedAt])
  @@index([tenantId])
  @@map("audit_verification")
}

// Field-level history for changes that are not fully represented by the
// coarse audit event. Values are stored as text so a record can be compared
// without losing null/empty distinctions.
model FieldChange {
  tenantId      String?  @map("tenant_id")
  id            String   @id @default(cuid())
  entityType    String   @map("entity_type")
  entityId      String   @map("entity_id")
  field         String
  oldValue      String?  @map("old_value")
  newValue      String?  @map("new_value")
  changedById   String?  @map("changed_by_id")
  changedByName String?  @map("changed_by_name")
  requestId     String?  @map("request_id")
  changedAt     DateTime @default(now()) @map("changed_at")

  @@index([entityType, entityId, changedAt])
  @@index([changedById, changedAt])
  @@index([tenantId])
  @@map("field_change")
}

// Durable scheduler lease. A web process may only run a background job while
// it owns the row; this prevents duplicate reminders and reports when more than
// one API instance is deployed.
model JobLock {
  name        String    @id
  lockedBy    String?   @map("locked_by")
  lockedUntil DateTime? @map("locked_until")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("job_lock")
}

// Signed external checkpoint over the audit chain head. The private key stays
// in the deployment secret store; the public key is used by auditors to verify
// that an exported range has not been rewritten.
model AuditCheckpoint {
  tenantId        String?  @map("tenant_id")
  id              String   @id @default(cuid())
  headId          BigInt   @map("head_id")
  headHash        String   @map("head_hash")
  checkedCount    Int      @map("checked_count")
  previousHash    String?  @map("previous_hash")
  algorithm       String   @default("Ed25519")
  keyId           String   @map("key_id")
  publicKeyPem    String   @map("public_key_pem")
  publicKeySha256 String   @map("public_key_sha256")
  signature       String
  payload         Json
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([tenantId])
  @@map("audit_checkpoint")
}

model Document {
  tenantId         String?   @map("tenant_id")
  id               String    @id @default(cuid())
  title            String
  docNumber        String?   @unique @map("doc_number")
  thematic         String
  thematicOther    String?   @map("thematic_other")
  type             String
  typeOther        String?   @map("type_other")
  unit             String?
  language         String    @default("English")
  version          String?
  firstEndorsement String?   @map("first_endorsement")
  recentRenewal    String?   @map("recent_renewal")
  expiry           String?
  status           String    @default("Active")
  notes            String?
  fileName         String?   @map("file_name")
  fileUrl          String?   @map("file_url")
  uploadedBy       String?   @map("uploaded_by")
  uploadDate       DateTime  @default(now()) @map("upload_date")
  folderPath       String?   @map("folder_path")
  projectId        String?   @map("project_id")
  // Internal archive by default; only public documents appear on the website.
  isPublic         Boolean   @default(false) @map("is_public")
  publishedAt      DateTime? @map("published_at")

  project Project? @relation(fields: [projectId], references: [projectId], onDelete: Cascade)

  @@index([projectId, uploadDate])
  @@index([tenantId])
  @@map("Document")
}

model HeroImage {
  tenantId  String?  @map("tenant_id")
  id        String   @id @default(cuid())
  url       String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("HeroImage")
}

// A hero slide: copy + the image it transitions with, plus optional CTA.
model HeroText {
  tenantId   String?  @map("tenant_id")
  id         String   @id @default(cuid())
  title      String
  titleAm    String?  @map("title_am")
  subtitle   String?
  subtitleAm String?  @map("subtitle_am")
  tagline    String?
  taglineAm  String?  @map("tagline_am")
  ctaLabel   String?  @map("cta_label")
  ctaLabelAm String?  @map("cta_label_am")
  ctaUrl     String?  @map("cta_url")
  imageUrl   String?  @map("image_url")
  sortOrder  Int      @default(0) @map("sort_order")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@index([tenantId])
  @@map("HeroText")
}

model DropdownOption {
  tenantId  String?  @map("tenant_id")
  id        String   @id @default(cuid())
  category  String
  value     String
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([category, value])
  @@index([tenantId])
  @@map("DropdownOption")
}

// ─── Collaboration ─────────────────────────────────────────────────────────────
model Comment {
  tenantId   String?  @map("tenant_id")
  id         String   @id @default(cuid())
  targetType String // "PROJECT" | "ACTIVITY" | "MILESTONE" | "DOCUMENT"
  targetId   String
  body       String
  author     String
  authorName String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  deleted    Boolean  @default(false)

  reactions Reaction[]

  @@index([targetType, targetId])
  @@index([author])
  @@index([tenantId])
  @@map("comment")
}

model Reaction {
  tenantId  String?  @map("tenant_id")
  id        String   @id @default(cuid())
  commentId String
  emoji     String
  author    String
  createdAt DateTime @default(now()) @map("created_at")

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([commentId, emoji, author])
  @@index([tenantId])
  @@map("reaction")
}

model ProjectMessage {
  tenantId  String?  @map("tenant_id")
  id        String   @id @default(cuid())
  projectId String
  title     String
  body      String
  author    String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [projectId], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([tenantId])
  @@map("project_message")
}

model ProjectBrief {
  tenantId  String?  @map("tenant_id")
  id        String   @id @default(cuid())
  projectId String   @unique
  content   String
  format    String   @default("markdown")
  updatedBy String?
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [projectId], onDelete: Cascade)

  @@index([tenantId])
  @@map("project_brief")
}

model ProjectMember {
  tenantId  String?  @map("tenant_id")
  id        String   @id @default(cuid())
  projectId String
  username  String
  role      String   @default("member")
  addedBy   String
  addedAt   DateTime @default(now()) @map("added_at")

  project Project @relation(fields: [projectId], references: [projectId], onDelete: Cascade)

  @@unique([projectId, username])
  @@index([username])
  @@index([tenantId])
  @@map("project_member")
}

model Notification {
  tenantId  String?  @map("tenant_id")
  id        String   @id @default(cuid())
  recipient String
  type      String // "COMMENT" | "MENTION" | "ASSIGNMENT" | "DEADLINE" | "STATUS_CHANGE"
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([recipient, read, createdAt])
  @@index([tenantId])
  @@map("notification")
}

model AutomationRule {
  tenantId     String?  @map("tenant_id")
  id           String   @id @default(cuid())
  projectId    String
  name         String
  enabled      Boolean  @default(true)
  triggerEvent String // e.g., "STATUS_CHANGE"
  triggerValue String? // e.g., "Complete"
  actionType   String // e.g., "NOTIFY" | "ASSIGN"
  actionTarget String? // e.g., "admin"
  actionValue  String? // e.g., "Task is done!"
  createdBy    String
  createdAt    DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [projectId], onDelete: Cascade)

  @@index([tenantId])
  @@map("automation_rule")
}

model Goal {
  tenantId           String?   @map("tenant_id")
  id                 String    @id @default(cuid())
  title              String
  description        String?
  targetDate         DateTime
  status             String    @default("On Track")
  progress           Int       @default(0)
  createdBy          String
  createdAt          DateTime  @default(now()) @map("created_at")
  // The corporate objective (a plan item in the AOP, Strategic Plan or
  // Roadmap) that this delivery-level project objective contributes to.
  planItemId         String?   @map("plan_item_id")
  corporateObjective PlanItem? @relation("GoalCorporateObjective", fields: [planItemId], references: [id], onDelete: SetNull)

  projects ProjectGoal[]

  @@index([tenantId])
  @@index([planItemId])
  @@map("goal")
}

model ProjectGoal {
  tenantId  String? @map("tenant_id")
  id        String  @id @default(cuid())
  goalId    String
  projectId String

  goal    Goal    @relation(fields: [goalId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [projectId], onDelete: Cascade)

  @@unique([goalId, projectId])
  @@index([tenantId])
  @@map("project_goal")
}

model TimeEntry {
  tenantId    String?  @map("tenant_id")
  id          String   @id @default(cuid())
  projectId   String
  activityId  String?
  username    String
  hours       Float
  description String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [projectId], onDelete: Cascade)

  @@index([projectId, username])
  @@index([tenantId])
  @@map("time_entry")
}

model Translation {
  tenantId  String?            @map("tenant_id")
  id        String             @id @default(cuid())
  key       String             @unique
  en        String
  am        String
  updatedAt DateTime           @updatedAt @map("updated_at")
  values    TranslationValue[]

  @@index([tenantId])
  @@map("translation")
}

// A language available in the public toggle. Adding a row (or importing a CSV
// column) adds it to Language & Translations without a schema migration.
model Language {
  tenantId   String?            @map("tenant_id")
  code       String             @id // en, am, om, so, ti, aa, ...
  name       String
  nativeName String?            @map("native_name")
  isEnabled  Boolean            @default(true) @map("is_enabled")
  sortOrder  Int                @default(0) @map("sort_order")
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")
  values     TranslationValue[]

  @@index([tenantId])
  @@map("language")
}

// Per-language text for a translation key (en/am stay on Translation for
// backward compatibility; every other language lives here).
model TranslationValue {
  tenantId      String?     @map("tenant_id")
  id            String      @id @default(cuid())
  translationId String      @map("translation_id")
  lang          String
  text          String
  updatedAt     DateTime    @updatedAt @map("updated_at")
  translation   Translation @relation(fields: [translationId], references: [id], onDelete: Cascade)
  language      Language    @relation(fields: [lang], references: [code], onDelete: Cascade)

  @@unique([translationId, lang])
  @@index([tenantId])
  @@map("translation_value")
}

model News {
  tenantId      String?      @map("tenant_id")
  id            String       @id @default(cuid())
  title         String
  content       String
  titleAm       String?      @map("title_am")
  contentAm     String?      @map("content_am")
  videoUrl      String?      @map("video_url")
  imageUrl      String?
  author        String
  // Editorial distribution. A news item can be shared automatically when it
  // is saved; each destination receives its own queue row and retry history.
  autoShare     Boolean      @default(true) @map("auto_share")
  socialCaption String?      @map("social_caption")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  socialPosts   SocialPost[]

  @@index([tenantId])
  @@map("news")
}

// â”€â”€â”€ Corporate planning: Strategic Plan / Roadmap / AOP by period â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Plan {
  tenantId     String?   @map("tenant_id")
  id           String    @id @default(cuid())
  type         String // "STRATEGIC" | "ROADMAP" | "AOP"
  title        String
  periodLabel  String    @map("period_label") // "2026-2030", "2026/27 EFY"
  startDate    DateTime  @map("start_date")
  endDate      DateTime  @map("end_date")
  status       String    @default("Draft") // Draft | Active | Closed
  summary      String?
  vision       String?
  mission      String?
  owner        String?
  isPublished  Boolean   @default(false) @map("is_published")
  reviewedBy   String?   @map("reviewed_by")
  reviewedAt   DateTime? @map("reviewed_at")
  approvedBy   String?   @map("approved_by")
  approvedAt   DateTime? @map("approved_at")
  publishedAt  DateTime? @map("published_at")
  revision     Int       @default(1)
  parentPlanId String?   @map("parent_plan_id")
  periodId     String?   @unique @map("period_id")
  createdBy    String    @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  parent          Plan?            @relation("PlanHierarchy", fields: [parentPlanId], references: [id], onDelete: SetNull)
  children        Plan[]           @relation("PlanHierarchy")
  period          PlanPeriod?      @relation(fields: [periodId], references: [id], onDelete: SetNull)
  items           PlanItem[]
  alerts          PlanAlert[]
  reports         PlanReport[]
  shares          PlanShare[]
  revisions       PlanRevision[]
  progressUpdates ProgressUpdate[]
  projects        Project[]

  @@unique([type, periodLabel])
  @@index([type, status])
  @@index([parentPlanId])
  @@index([tenantId])
  @@map("plan")
}

// A planning period is a first-class record: it outlives any single plan row,
// carries the cycle position (sequence), its place in the hierarchy of periods
// and a link to its successor so every period can renew into the next one.
model PlanPeriod {
  tenantId       String?   @map("tenant_id")
  id             String    @id @default(cuid())
  type           String // "STRATEGIC" | "ROADMAP" | "AOP"
  sequence       Int // 1, 2, 3 ... never reused within a type
  label          String // "2019 EFY", "2026-2030"
  labelAlt       String?   @map("label_alt") // "2026/27", Gregorian equivalent
  startDate      DateTime  @map("start_date")
  endDate        DateTime  @map("end_date")
  state          String    @default("Planned") // Planned | Preparing | Active | Closing | Closed | Archived
  parentPeriodId String?   @map("parent_period_id")
  successorId    String?   @unique @map("successor_id")
  preparedAt     DateTime? @map("prepared_at")
  activatedAt    DateTime? @map("activated_at")
  closedAt       DateTime? @map("closed_at")
  createdBy      String    @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  parent          PlanPeriod?        @relation("PeriodHierarchy", fields: [parentPeriodId], references: [id], onDelete: SetNull)
  children        PlanPeriod[]       @relation("PeriodHierarchy")
  successor       PlanPeriod?        @relation("PeriodSuccession", fields: [successorId], references: [id], onDelete: SetNull)
  predecessor     PlanPeriod?        @relation("PeriodSuccession")
  plan            Plan?
  transitions     PeriodTransition[]
  progressUpdates ProgressUpdate[]

  @@unique([type, sequence])
  @@unique([type, label])
  @@index([type, state, startDate])
  @@index([tenantId])
  @@map("plan_period")
}

// Append-only ledger of every lifecycle action, so the daily job is idempotent
// and every automatic decision on a period can be explained later.
model PeriodTransition {
  tenantId  String?  @map("tenant_id")
  id        String   @id @default(cuid())
  periodId  String   @map("period_id")
  action    String // PREPARE | ACTIVATE | CLOSE | ARCHIVE | AMEND | NOTIFY
  actor     String   @default("system")
  note      String?
  dedupeKey String   @unique @map("dedupe_key")
  createdAt DateTime @default(now()) @map("created_at")

  period PlanPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@index([periodId, createdAt])
  @@index([tenantId])
  @@map("period_transition")
}

// Single adjacency-list tree so a plan can hold pillars, goals, objectives,
// strategies, activities, KPIs and milestones at any depth without migrations.
model PlanItem {
  tenantId     String? @map("tenant_id")
  id           String  @id @default(cuid())
  planId       String  @map("plan_id")
  parentId     String? @map("parent_id")
  linkedItemId String? @map("linked_item_id")
  kind         String // PILLAR | GOAL | OBJECTIVE | STRATEGY | ACTIVITY | KPI | MILESTONE
  code         String? // "SO1", "Pillar 2"
  title        String
  description  String?
  owner        String?
  sortOrder    Int     @default(0) @map("sort_order")

  // KPI definition
  unit         String?
  baseline     Float?
  targetValue  Float?  @map("target_value")
  currentValue Float?  @map("current_value")
  direction    String? // increase | decrease
  frequency    String? // Annual | Quarterly | Monthly
  dataSource   String? @map("data_source")
  isFeatured   Boolean @default(false) @map("is_featured")

  // Activity / milestone schedule
  startDate DateTime? @map("start_date")
  endDate   DateTime? @map("end_date")
  budget    Float?
  status    String    @default("Planned") // Planned | In Progress | Completed | At Risk
  progress  Int       @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  plan            Plan             @relation(fields: [planId], references: [id], onDelete: Cascade)
  parent          PlanItem?        @relation("PlanItemTree", fields: [parentId], references: [id], onDelete: Cascade)
  children        PlanItem[]       @relation("PlanItemTree")
  linkedItem      PlanItem?        @relation("ItemAlignment", fields: [linkedItemId], references: [id], onDelete: SetNull)
  alignedItems    PlanItem[]       @relation("ItemAlignment")
  targets         PlanKpiTarget[]
  alerts          PlanAlert[]
  progressUpdates ProgressUpdate[]
  linkedGoals     Goal[]           @relation("GoalCorporateObjective")

  @@index([planId, parentId, sortOrder])
  @@index([linkedItemId])
  @@index([tenantId])
  @@map("plan_item")
}

// Year-by-year (or quarter-by-quarter) target/actual readings for a KPI.
model PlanKpiTarget {
  tenantId    String? @map("tenant_id")
  id          String  @id @default(cuid())
  itemId      String  @map("item_id")
  periodLabel String  @map("period_label") // "2026", "Q4 2028"
  target      Float?
  targetLabel String? @map("target_label") // qualitative target, e.g. "ISO 13485 certified"
  actual      Float?
  note        String?

  item PlanItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, periodLabel])
  @@index([tenantId])
  @@map("plan_kpi_target")
}

// Reporting obligation for a plan period (monthly, quarterly, annual...).
// A task owner's narrative + percentage update on a plan item for a period.
// The consolidated annual/strategic/roadmap reports read the latest of these.
model ProgressUpdate {
  tenantId     String?   @map("tenant_id")
  id           String    @id @default(cuid())
  reference    String?   @unique
  planId       String    @map("plan_id")
  periodId     String?   @map("period_id")
  itemId       String    @map("item_id")
  periodLabel  String    @default("") @map("period_label")
  authorId     String    @map("author_id")
  authorName   String?   @map("author_name")
  progress     Int       @default(0)
  status       String    @default("Draft") // Draft | Submitted | Reviewed (legacy) | Verified
  summary      String
  achievements String?
  challenges   String?
  nextSteps    String?   @map("next_steps")
  reviewedBy   String?   @map("reviewed_by")
  reviewedAt   DateTime? @map("reviewed_at")
  reviewerNote String?   @map("reviewer_note")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  plan   Plan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  period PlanPeriod? @relation(fields: [periodId], references: [id], onDelete: SetNull)
  item   PlanItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, periodLabel])
  @@index([planId, periodLabel])
  @@index([periodId, status])
  @@index([authorId, status])
  @@index([tenantId])
  @@map("progress_update")
}

model PlanReport {
  tenantId    String?   @map("tenant_id")
  id          String    @id @default(cuid())
  planId      String    @map("plan_id")
  title       String
  type        String // MONTHLY | QUARTERLY | SEMI_ANNUAL | ANNUAL | AD_HOC
  periodLabel String    @map("period_label")
  dueDate     DateTime  @map("due_date")
  owner       String?
  status      String    @default("Pending") // Pending | Submitted | Approved | Waived
  submittedAt DateTime? @map("submitted_at")
  submittedBy String?   @map("submitted_by")
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  plan   Plan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  alerts PlanAlert[]

  @@index([planId, dueDate])
  @@index([status, dueDate])
  @@index([tenantId])
  @@map("plan_report")
}

// Target-performance or reporting-deadline alert raised by the watch run.
model PlanAlert {
  tenantId       String?   @map("tenant_id")
  id             String    @id @default(cuid())
  planId         String    @map("plan_id")
  itemId         String?   @map("item_id")
  reportId       String?   @map("report_id")
  dedupeKey      String    @unique @map("dedupe_key")
  periodLabel    String    @default("") @map("period_label")
  severity       String // INFO | WARNING | CRITICAL
  rule           String // TARGET_MISSED | BEHIND_PACE | DUE_SOON | OVERDUE | REPORT_DUE
  title          String
  message        String
  expected       Float?
  actual         Float?
  progress       Float?
  status         String    @default("Open") // Open | Acknowledged | Resolved
  emailsSent     Int       @default(0) @map("emails_sent")
  acknowledgedBy String?   @map("acknowledged_by")
  acknowledgedAt DateTime? @map("acknowledged_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  plan   Plan            @relation(fields: [planId], references: [id], onDelete: Cascade)
  item   PlanItem?       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  report PlanReport?     @relation(fields: [reportId], references: [id], onDelete: Cascade)
  mails  PlanAlertMail[]

  @@index([planId, status, createdAt])
  @@index([status, createdAt])
  @@index([tenantId])
  @@map("plan_alert")
}

// Audit trail of every alert email attempt (SENT / SKIPPED / FAILED).
model PlanAlertMail {
  tenantId  String?  @map("tenant_id")
  id        String   @id @default(cuid())
  alertId   String   @map("alert_id")
  to        String
  subject   String
  status    String // SENT | SKIPPED | FAILED
  error     String?
  createdAt DateTime @default(now()) @map("created_at")

  alert PlanAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([tenantId])
  @@map("plan_alert_mail")
}

// Immutable snapshot captured at approval/publish (or manually).
model PlanRevision {
  tenantId  String?  @map("tenant_id")
  id        String   @id @default(cuid())
  planId    String   @map("plan_id")
  revision  Int
  status    String
  note      String?
  snapshot  Json
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, createdAt])
  @@index([tenantId])
  @@map("plan_revision")
}

// A restricted, token-based read-only link to one plan, with a comment channel.
model PlanShare {
  tenantId     String?   @map("tenant_id")
  id           String    @id @default(cuid())
  planId       String    @map("plan_id")
  token        String    @unique
  label        String?
  isActive     Boolean   @default(true) @map("is_active")
  expiresAt    DateTime? @map("expires_at")
  createdBy    String    @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  lastViewedAt DateTime? @map("last_viewed_at")
  viewCount    Int       @default(0) @map("view_count")

  plan     Plan               @relation(fields: [planId], references: [id], onDelete: Cascade)
  comments PlanShareComment[]

  @@index([planId])
  @@index([tenantId])
  @@map("plan_share")
}

model PlanShareComment {
  tenantId    String?  @map("tenant_id")
  id          String   @id @default(cuid())
  shareId     String   @map("share_id")
  planId      String   @map("plan_id")
  authorName  String   @map("author_name")
  authorEmail String?  @map("author_email")
  body        String
  context     String?
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at")

  share PlanShare @relation(fields: [shareId], references: [id], onDelete: Cascade)

  @@index([planId, isRead, createdAt])
  @@index([tenantId])
  @@map("plan_share_comment")
}

// Admin-editable runtime configuration (alert thresholds, recipients, etc.)
model AppSetting {
  tenantId  String?  @map("tenant_id")
  key       String   @id
  value     Json
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("app_setting")
}

model VisitorLog {
  tenantId  String?  @map("tenant_id")
  id        String   @id @default(cuid())
  ip        String
  visitedAt DateTime @default(now())

  @@index([tenantId])
}

// Video items shown in the public "Media" section, managed from the admin panel.
model MediaVideo {
  tenantId    String?  @map("tenant_id")
  id          String   @id @default(cuid())
  title       String
  titleAm     String?  @map("title_am")
  caption     String?
  captionAm   String?  @map("caption_am")
  videoUrl    String   @map("video_url")
  posterUrl   String?  @map("poster_url")
  captionsUrl String?  @map("captions_url")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@index([tenantId])
  @@map("media_video")
}

// --- PHASE 2 HR MODELS ---

model Training {
  tenantId       String?   @map("tenant_id")
  id             String    @id @default(cuid())
  userId         String
  title          String
  provider       String
  completedAt    DateTime
  expiresAt      DateTime?
  certificateUrl String?
  category       String? // GMP | Safety | Technical | Leadership | Compliance | Other
  hours          Float?
  result         String? // Pass | Complete | Distinction | Attended
  notes          String?
  createdAt      DateTime  @default(now())
  user           User      @relation("UserTraining", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, completedAt])
  @@index([tenantId])
}

model LeaveRequest {
