model Comment {
  id         String   @id @default(cuid())
  targetType String   // "PROJECT" | "ACTIVITY" | "MILESTONE" | "DOCUMENT"
  targetId   String
  body       String
  author     String
  authorName String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  deleted    Boolean  @default(false)

  reactions  Reaction[]

  @@index([targetType, targetId])
  @@index([author])
  @@map("comment")
}

model Reaction {
  id         String   @id @default(cuid())
  commentId  String
  emoji      String
  author     String
  createdAt  DateTime @default(now()) @map("created_at")

  comment    Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([commentId, emoji, author])
  @@map("reaction")
}

model ProjectMessage {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  body        String
  author      String
  pinned      Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project     Project  @relation(fields: [projectId], references: [projectId], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("project_message")
}

model ProjectBrief {
  id         String   @id @default(cuid())
  projectId  String   @unique
  content    String
  format     String   @default("markdown")
  updatedBy  String?
  updatedAt  DateTime @updatedAt @map("updated_at")
  createdAt  DateTime @default(now()) @map("created_at")

  project    Project  @relation(fields: [projectId], references: [projectId], onDelete: Cascade)

  @@map("project_brief")
}

model ProjectMember {
  id         String   @id @default(cuid())
  projectId  String
  username   String
  role       String   @default("member")
  addedBy    String
  addedAt    DateTime @default(now()) @map("added_at")

  project    Project  @relation(fields: [projectId], references: [projectId], onDelete: Cascade)

  @@unique([projectId, username])
  @@index([username])
  @@map("project_member")
}
model Notification {
  id         String   @id @default(cuid())
  recipient  String
  type       String   // "COMMENT" | "MENTION" | "ASSIGNMENT" | "DEADLINE" | "STATUS_CHANGE"
  title      String
  body       String?
  link       String?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([recipient, read, createdAt])
  @@map("notification")
}
model AutomationRule {
  id           String   @id @default(cuid())
  projectId    String
  name         String
  enabled      Boolean  @default(true)
  triggerEvent String   // e.g., "STATUS_CHANGE"
  triggerValue String?  // e.g., "Complete"
  actionType   String   // e.g., "NOTIFY" | "ASSIGN"
  actionTarget String?  // e.g., "admin"
  actionValue  String?  // e.g., "Task is done!"
  createdBy    String
  createdAt    DateTime @default(now()) @map("created_at")

  project      Project  @relation(fields: [projectId], references: [projectId], onDelete: Cascade)

  @@map("automation_rule")
}
model Goal {
  id          String   @id @default(cuid())
  title       String
  description String?
  targetDate  DateTime
  status      String   @default("On Track")
  progress    Int      @default(0)
  createdBy   String
  createdAt   DateTime @default(now()) @map("created_at")

  projects    ProjectGoal[]

  @@map("goal")
}

model ProjectGoal {
  id        String   @id @default(cuid())
  goalId    String
  projectId String
  
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [projectId], onDelete: Cascade)

  @@unique([goalId, projectId])
  @@map("project_goal")
}

model TimeEntry {
  id          String   @id @default(cuid())
  projectId   String
  activityId  String?
  username    String
  hours       Float
  description String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now()) @map("created_at")

  project     Project  @relation(fields: [projectId], references: [projectId], onDelete: Cascade)

  @@index([projectId, username])
  @@map("time_entry")
}
model Translation {
  id        String   @id @default(cuid())
  key       String   @unique
  en        String
  am        String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("translation")
}
model News {
  id        String   @id @default(cuid())
  title     String
  content   String
  imageUrl  String?
  author    String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("news")
}