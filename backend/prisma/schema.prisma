  id              String   @id @default(cuid())
  userId          String
  user            User     @relation("LeaveRequester", fields: [userId], references: [id], onDelete: Cascade)
  type            String // ANNUAL | SICK | MATERNITY | UNPAID
  startDate       DateTime
  endDate         DateTime
  status          String   @default("PENDING") // PENDING | APPROVED | REJECTED
  reason          String?
  rejectionReason String?
  supervisorId    String?
  supervisor      User?    @relation("LeaveSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  approvedById    String?
  approvedBy      User?    @relation("LeaveApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  // (removed duplicate user relation)

  @@index([tenantId])
}

model AttendanceLog {
  tenantId String?   @map("tenant_id")
  id       String    @id @default(cuid())
  userId   String
  date     DateTime
  clockIn  DateTime?
  clockOut DateTime?
  status   String // PRESENT | ABSENT | LATE | HOLIDAY
  user     User      @relation("UserAttendance", fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// --- LEAVE BALANCE MODELS ---

model LeaveType {
  tenantId         String?  @map("tenant_id")
  id               String   @id @default(cuid())
  name             String   @unique // e.g., "Annual Leave", "Sick Leave"
  code             String   @unique // e.g., "ANNUAL", "SICK"
  shortCode        String?  @unique @map("short_code") // two-letter timesheet code, e.g. "AL", "SL", "AB"
  defaultDays      Int      @default(20)
  maxRolloverDays  Int      @default(5)
  rolloverExpireYr Int      @default(1)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  @@index([tenantId])
}

model LeaveBalance {
  tenantId     String? @map("tenant_id")
  id           String  @id @default(cuid())
  userId       String
  year         Int
  leaveType    String  @default("ANNUAL")
  entitledDays Float   @default(0)
  usedDays     Float   @default(0)
  rolloverDays Float   @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, leaveType])
  @@index([tenantId])
}

// --- ANNUAL LEAVE PLANNING MODELS ---

model AnnualLeavePlan {
  tenantId        String?   @map("tenant_id")
  id              String    @id @default(cuid())
  userId          String
  year            Int
  status          String    @default("DRAFT") // DRAFT | SUBMITTED | APPROVED | REJECTED | VERIFIED
  submittedAt     DateTime?
  supervisorId    String?
  supervisor      User?     @relation("PlanSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  approvedAt      DateTime?
  rejectionReason String?
  hrVerifiedAt    DateTime?
  createdAt       DateTime  @default(now())

  user  User                  @relation("UserAnnualPlans", fields: [userId], references: [id], onDelete: Cascade)
