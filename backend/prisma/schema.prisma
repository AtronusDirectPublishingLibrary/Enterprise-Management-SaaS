generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id            String   @id @default(cuid())
  projectId     String   @unique
  title         String
  description   String?
  sourceOfFunds String
  startDate     DateTime
  endDate       DateTime
  status        String   @default("Not Started")
  priority      String   @default("Medium")
  progress      Int      @default(0)
  createdBy     String
  dependencies  String?

  createdDate      DateTime  @default(now())
  lastModifiedBy   String?
  lastModifiedDate DateTime?
  projectCategory  String?
  leadDirectorate  String?
  leadDivision     String?
  piName           String?
  piEmail          String?
  projectManager   String?

  workPackages    WorkPackage[]
  documents       Document[]
  brief           ProjectBrief?
  members         ProjectMember[]
  messages        ProjectMessage[]
  automationRules AutomationRule[]
  goals           ProjectGoal[]
  timeEntries     TimeEntry[]
  milestones      Milestone[]
  activities      Activity[]

  @@map("Project")
}

model WorkPackage {
  id            String   @id @default(cuid())
  projectId     String
  workPackageId String   @unique
  title         String
  description   String?
  startDate     DateTime
  endDate       DateTime
  progress      Int      @default(0)
  status        String   @default("Not Started")
  createdBy     String
  dependencies  String?
  // Username of the project-team member accountable for delivery.
  ownerUsername String?  @map("owner_username")
  ownerName     String?  @map("owner_name")

  createdDate      DateTime  @default(now())
  lastModifiedBy   String?
  lastModifiedDate DateTime?

  project    Project    @relation(fields: [projectId], references: [projectId], onDelete: Cascade)
  activities Activity[]

  @@map("WorkPackage")
}

model Milestone {
  id           String   @id @default(cuid())
  projectId    String
  milestoneId  String   @unique
  title        String
  description  String?
  startDate    DateTime
  endDate      DateTime
  progress     Int      @default(0)
  status       String   @default("Not Started")
  createdBy    String
  dependencies String?

  createdDate      DateTime  @default(now())
  lastModifiedBy   String?
  lastModifiedDate DateTime?

  // Self-relation for Milestone Dependencies
  predecessors Milestone[] @relation("MilestoneDependencies")
  successors   Milestone[] @relation("MilestoneDependencies")

  project Project @relation(fields: [projectId], references: [projectId], onDelete: Cascade)

  @@map("Milestone")
}

model Activity {
  id                String   @id @default(cuid())
  projectId         String
  workPackageId     String?
  parentActivityId  String?
  milestoneId       String?
  activityId        String   @unique
  title             String
  description       String?
  startDate         DateTime
  endDate           DateTime
  duration          Int?
  progress          Int      @default(0)
  assignedTo        String?
  status            String   @default("Not Started")
  financialPlan     Decimal  @default(0) @db.Decimal(14, 2)
  actualExpenditure Decimal  @default(0) @db.Decimal(14, 2)
  createdBy         String
  dependencies      String?

  createdDate      DateTime  @default(now())
  lastModifiedBy   String?
  lastModifiedDate DateTime?

  project     Project      @relation(fields: [projectId], references: [projectId], onDelete: Cascade)
  workPackage WorkPackage? @relation(fields: [workPackageId], references: [workPackageId], onDelete: SetNull)
  parent      Activity?    @relation("ActivityTree", fields: [parentActivityId], references: [activityId], onDelete: Cascade)
  children    Activity[]   @relation("ActivityTree")

  // Self-relation for Activity Dependencies
  predecessors Activity[] @relation("ActivityDependencies")
  successors   Activity[] @relation("ActivityDependencies")

  @@map("Activity")
}

model User {
  id                 String    @id @default(cuid())
  firstName          String?   @map("first_name")
  lastName           String?   @map("last_name")
  username           String    @unique
  passwordHash       String    @map("password_hash")
  role               String    @default("viewer")
  associatedGrants   String[]  @default([]) @map("associated_grants")
  department         String?   @map("department")
  subDepartment      String?   @map("sub_department")
  piName             String?   @map("pi_name")
  coPiName           String?   @map("co_pi_name")
  email              String?
  lastLogin          DateTime? @map("last_login")
  createdDate        DateTime  @default(now()) @map("created_date")
  forceChange        Boolean   @default(false) @map("force_change")
  mfaEnabled         Boolean   @default(false) @map("mfa_enabled")
  mfaSecret          String?   @map("mfa_secret")
  // Staff self-service profile
  profession         String?
  requiresLicence    Boolean   @default(false) @map("requires_licence")
  profileCompletedAt DateTime? @map("profile_completed_at")
  // Optional e-signature assets. A typed name is always accepted at signing;
  // these images are stamped onto signed records when the person has uploaded them.
  signatureUrl       String?   @map("signature_url")
  initialsUrl        String?   @map("initials_url")
  initialsText       String?   @map("initials_text")
  signatureUpdatedAt DateTime? @map("signature_updated_at")
  avatarUrl          String?   @map("avatar_url")
  avatarUpdatedAt    DateTime? @map("avatar_updated_at")
  employeeNo         String?   @unique @map("employee_no")
  jobTitle           String?   @map("job_title")
  // Canonical position from the HR position list (or a free-text "Other" value).
  position           String?   @map("position")
  phone              String?
  hireDate           DateTime? @map("hire_date")
  probationEnd       DateTime? @map("probation_end")
  contractEnd        DateTime? @map("contract_end")
  // Regular | Contract | Part-time | Other: <specify>
  employmentType     String?   @map("employment_type")
  // HR Utility relations

  immediateSupervisorId String? @map("immediate_supervisor_id")
  immediateSupervisor   User?   @relation("UserSupervisor", fields: [immediateSupervisorId], references: [id], onDelete: SetNull)
  directReports         User[]  @relation("UserSupervisor")

  trainingRecords        Training[]     @relation("UserTraining")
  leaveRequestsMade      LeaveRequest[] @relation("LeaveRequester")
  leaveRequestsToApprove LeaveRequest[] @relation("LeaveSupervisor")
  leaveRequestsApproved  LeaveRequest[] @relation("LeaveApprover")

  attendanceLogs AttendanceLog[] @relation("UserAttendance")
  LeaveBalance   LeaveBalance[]

  annualPlans    AnnualLeavePlan[] @relation("UserAnnualPlans")
  plansToApprove AnnualLeavePlan[] @relation("PlanSupervisor")

  // Timesheet relations
  timesheets          Timesheet[]    @relation("UserTimesheets")
  timesheetsToApprove Timesheet[]    @relation("TimesheetSupervisor")
  salaryRecords       SalaryRecord[]
  payslips            Payslip[]

  staffTasks     StaffTask[]     @relation("UserStaffTasks")
  staffDocuments StaffDocument[] @relation("UserStaffDocuments")
  inductions     Induction[]     @relation("UserInduction")
  appraisals     Appraisal[]     @relation("UserAppraisals")

  signatures              SignatureRecord[]          @relation("UserSignatures")
  jobDescriptionUploads   JobDescription[]           @relation("JobDescriptionUploader")
  jobDescriptions         JobDescriptionAssignment[] @relation("UserJobDescriptions")
  jobDescriptionsAssigned JobDescriptionAssignment[] @relation("JobDescriptionAssigner")
  recruitmentRequests     RecruitmentRequest[]       @relation("RecruitmentRequester")
  recruitmentApprovals    RecruitmentRequest[]       @relation("RecruitmentApprover")
  offboardingCases        OffboardingCase[]          @relation("UserOffboarding")
  offboardingInitiated    OffboardingCase[]          @relation("OffboardingInitiator")
  offboardingManaged      OffboardingCase[]          @relation("OffboardingManager")

  // Fleet & transport
  vehicleRequestsMade          VehicleRequest[] @relation("VehicleRequester")
  vehicleRequestsToApprove     VehicleRequest[] @relation("VehicleRequestSupervisor")
  vehicleRequestsFleetApproved VehicleRequest[] @relation("VehicleRequestFleetApprover")
  rideRequestsMade             RideRequest[]    @relation("RideRequester")
  rideRequestsToApprove        RideRequest[]    @relation("RideSupervisor")
  rideRequestsApproved         RideRequest[]    @relation("RideApprover")
  driverProfile                Driver?          @relation("DriverUser")

  // QMS document control
  qmsDocumentsOwned    QmsDocument[] @relation("QmsDocumentOwner")
  qmsDocumentsReviewed QmsDocument[] @relation("QmsDocumentReviewer")
  qmsDocumentsApproved QmsDocument[] @relation("QmsDocumentApprover")

  // QMS quality events and improvements
  qmsDeviationsReported QmsDeviation[]     @relation("QmsDeviationReporter")
  qmsDeviationsOwned    QmsDeviation[]     @relation("QmsDeviationOwner")
  qmsDeviationsClosed   QmsDeviation[]     @relation("QmsDeviationCloser")
  qmsCapasOwned         QmsCapa[]          @relation("QmsCapaOwner")
  qmsCapasVerified      QmsCapa[]          @relation("QmsCapaVerifier")
  qmsChangesOwned       QmsChangeControl[] @relation("QmsChangeOwner")
  qmsChangesApproved    QmsChangeControl[] @relation("QmsChangeApprover")

  @@map("users")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  timestamp DateTime @default(now())
  grantId   String?  @map("grant_id")
  action    String
  user      String
  details   Json?

  @@map("audit_log")
}

model Document {
  id               String   @id @default(cuid())
  title            String
  docNumber        String?  @unique @map("doc_number")
  thematic         String
  thematicOther    String?  @map("thematic_other")
  type             String
  typeOther        String?  @map("type_other")
  unit             String?
  language         String   @default("English")
  version          String?
  firstEndorsement String?  @map("first_endorsement")
  recentRenewal    String?  @map("recent_renewal")
  expiry           String?
  status           String   @default("Active")
  notes            String?
  fileName         String?  @map("file_name")
  fileUrl          String?  @map("file_url")
  uploadedBy       String?  @map("uploaded_by")
  uploadDate       DateTime @default(now()) @map("upload_date")
  folderPath       String?  @map("folder_path")
  projectId        String?  @map("project_id")
  // Internal archive by default; only public documents appear on the website.
  isPublic         Boolean  @default(false) @map("is_public")
  publishedAt      DateTime? @map("published_at")

  project Project? @relation(fields: [projectId], references: [projectId], onDelete: Cascade)

  @@index([projectId, uploadDate])
  @@map("Document")
}

model HeroImage {
  id        String   @id @default(cuid())
  url       String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("HeroImage")
}

// A hero slide: copy + the image it transitions with, plus optional CTA.
model HeroText {
  id         String   @id @default(cuid())
  title      String
  titleAm    String?  @map("title_am")
  subtitle   String?
  subtitleAm String?  @map("subtitle_am")
  tagline    String?
  taglineAm  String?  @map("tagline_am")
  ctaLabel   String?  @map("cta_label")
  ctaLabelAm String?  @map("cta_label_am")
  ctaUrl     String?  @map("cta_url")
  imageUrl   String?  @map("image_url")
  sortOrder  Int      @default(0) @map("sort_order")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("HeroText")
}

model DropdownOption {
  id        String   @id @default(cuid())
  category  String
  value     String
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([category, value])
  @@map("DropdownOption")
}

// ─── Collaboration ─────────────────────────────────────────────────────────────
model Comment {
  id         String   @id @default(cuid())
  targetType String // "PROJECT" | "ACTIVITY" | "MILESTONE" | "DOCUMENT"
  targetId   String
  body       String
  author     String
  authorName String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  deleted    Boolean  @default(false)

  reactions Reaction[]

  @@index([targetType, targetId])
  @@index([author])
  @@map("comment")
}

model Reaction {
  id        String   @id @default(cuid())
  commentId String
  emoji     String
  author    String
  createdAt DateTime @default(now()) @map("created_at")

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([commentId, emoji, author])
  @@map("reaction")
}

model ProjectMessage {
  id        String   @id @default(cuid())
  projectId String
  title     String
  body      String
  author    String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [projectId], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("project_message")
}

model ProjectBrief {
  id        String   @id @default(cuid())
  projectId String   @unique
  content   String
  format    String   @default("markdown")
  updatedBy String?
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [projectId], onDelete: Cascade)

  @@map("project_brief")
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  username  String
  role      String   @default("member")
  addedBy   String
  addedAt   DateTime @default(now()) @map("added_at")

  project Project @relation(fields: [projectId], references: [projectId], onDelete: Cascade)

  @@unique([projectId, username])
  @@index([username])
  @@map("project_member")
}

model Notification {
  id        String   @id @default(cuid())
  recipient String
  type      String // "COMMENT" | "MENTION" | "ASSIGNMENT" | "DEADLINE" | "STATUS_CHANGE"
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([recipient, read, createdAt])
  @@map("notification")
}

model AutomationRule {
  id           String   @id @default(cuid())
  projectId    String
  name         String
  enabled      Boolean  @default(true)
  triggerEvent String // e.g., "STATUS_CHANGE"
  triggerValue String? // e.g., "Complete"
  actionType   String // e.g., "NOTIFY" | "ASSIGN"
  actionTarget String? // e.g., "admin"
  actionValue  String? // e.g., "Task is done!"
  createdBy    String
  createdAt    DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [projectId], onDelete: Cascade)

  @@map("automation_rule")
}

model Goal {
  id          String   @id @default(cuid())
  title       String
  description String?
  targetDate  DateTime
  status      String   @default("On Track")
  progress    Int      @default(0)
  createdBy   String
  createdAt   DateTime @default(now()) @map("created_at")

  projects ProjectGoal[]

  @@map("goal")
}

model ProjectGoal {
  id        String @id @default(cuid())
  goalId    String
  projectId String

  goal    Goal    @relation(fields: [goalId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [projectId], onDelete: Cascade)

  @@unique([goalId, projectId])
  @@map("project_goal")
}

model TimeEntry {
  id          String   @id @default(cuid())
  projectId   String
  activityId  String?
  username    String
  hours       Float
  description String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [projectId], onDelete: Cascade)

  @@index([projectId, username])
  @@map("time_entry")
}

model Translation {
  id        String             @id @default(cuid())
  key       String             @unique
  en        String
  am        String
  updatedAt DateTime           @updatedAt @map("updated_at")
  values    TranslationValue[]

  @@map("translation")
}

// A language available in the public toggle. Adding a row (or importing a CSV
// column) adds it to Language & Translations without a schema migration.
model Language {
  code       String             @id // en, am, om, so, ti, aa, ...
  name       String
  nativeName String?            @map("native_name")
  isEnabled  Boolean            @default(true) @map("is_enabled")
  sortOrder  Int                @default(0) @map("sort_order")
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")
  values     TranslationValue[]

  @@map("language")
}

// Per-language text for a translation key (en/am stay on Translation for
// backward compatibility; every other language lives here).
model TranslationValue {
  id            String      @id @default(cuid())
  translationId String      @map("translation_id")
  lang          String
  text          String
  updatedAt     DateTime    @updatedAt @map("updated_at")
  translation   Translation @relation(fields: [translationId], references: [id], onDelete: Cascade)
  language      Language    @relation(fields: [lang], references: [code], onDelete: Cascade)

  @@unique([translationId, lang])
  @@map("translation_value")
}

model News {
  id        String   @id @default(cuid())
  title     String
  content   String
  titleAm   String?  @map("title_am")
  contentAm String?  @map("content_am")
  videoUrl  String?  @map("video_url")
  imageUrl  String?
  author    String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("news")
}

// â”€â”€â”€ Corporate planning: Strategic Plan / Roadmap / AOP by period â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Plan {
  id           String    @id @default(cuid())
  type         String // "STRATEGIC" | "ROADMAP" | "AOP"
  title        String
  periodLabel  String    @map("period_label") // "2026-2030", "2026/27 EFY"
  startDate    DateTime  @map("start_date")
  endDate      DateTime  @map("end_date")
  status       String    @default("Draft") // Draft | Active | Closed
  summary      String?
  vision       String?
  mission      String?
  owner        String?
  isPublished  Boolean   @default(false) @map("is_published")
  reviewedBy   String?   @map("reviewed_by")
  reviewedAt   DateTime? @map("reviewed_at")
  approvedBy   String?   @map("approved_by")
  approvedAt   DateTime? @map("approved_at")
  publishedAt  DateTime? @map("published_at")
  revision     Int       @default(1)
  parentPlanId String?   @map("parent_plan_id")
  periodId     String?   @unique @map("period_id")
  createdBy    String    @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  parent          Plan?            @relation("PlanHierarchy", fields: [parentPlanId], references: [id], onDelete: SetNull)
  children        Plan[]           @relation("PlanHierarchy")
  period          PlanPeriod?      @relation(fields: [periodId], references: [id], onDelete: SetNull)
  items           PlanItem[]
  alerts          PlanAlert[]
  reports         PlanReport[]
  shares          PlanShare[]
  revisions       PlanRevision[]
  progressUpdates ProgressUpdate[]

  @@unique([type, periodLabel])
  @@index([type, status])
  @@index([parentPlanId])
  @@map("plan")
}

// A planning period is a first-class record: it outlives any single plan row,
// carries the cycle position (sequence), its place in the hierarchy of periods
// and a link to its successor so every period can renew into the next one.
model PlanPeriod {
  id             String    @id @default(cuid())
  type           String // "STRATEGIC" | "ROADMAP" | "AOP"
  sequence       Int // 1, 2, 3 ... never reused within a type
  label          String // "2019 EFY", "2026-2030"
  labelAlt       String?   @map("label_alt") // "2026/27", Gregorian equivalent
  startDate      DateTime  @map("start_date")
  endDate        DateTime  @map("end_date")
  state          String    @default("Planned") // Planned | Preparing | Active | Closing | Closed | Archived
  parentPeriodId String?   @map("parent_period_id")
  successorId    String?   @unique @map("successor_id")
  preparedAt     DateTime? @map("prepared_at")
  activatedAt    DateTime? @map("activated_at")
  closedAt       DateTime? @map("closed_at")
  createdBy      String    @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  parent          PlanPeriod?        @relation("PeriodHierarchy", fields: [parentPeriodId], references: [id], onDelete: SetNull)
  children        PlanPeriod[]       @relation("PeriodHierarchy")
  successor       PlanPeriod?        @relation("PeriodSuccession", fields: [successorId], references: [id], onDelete: SetNull)
  predecessor     PlanPeriod?        @relation("PeriodSuccession")
  plan            Plan?
  transitions     PeriodTransition[]
  progressUpdates ProgressUpdate[]

  @@unique([type, sequence])
  @@unique([type, label])
  @@index([type, state, startDate])
  @@map("plan_period")
}

// Append-only ledger of every lifecycle action, so the daily job is idempotent
// and every automatic decision on a period can be explained later.
model PeriodTransition {
  id        String   @id @default(cuid())
  periodId  String   @map("period_id")
  action    String // PREPARE | ACTIVATE | CLOSE | ARCHIVE | AMEND | NOTIFY
  actor     String   @default("system")
  note      String?
  dedupeKey String   @unique @map("dedupe_key")
  createdAt DateTime @default(now()) @map("created_at")

  period PlanPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@index([periodId, createdAt])
  @@map("period_transition")
}

// Single adjacency-list tree so a plan can hold pillars, goals, objectives,
// strategies, activities, KPIs and milestones at any depth without migrations.
model PlanItem {
  id           String  @id @default(cuid())
  planId       String  @map("plan_id")
  parentId     String? @map("parent_id")
  linkedItemId String? @map("linked_item_id")
  kind         String // PILLAR | GOAL | OBJECTIVE | STRATEGY | ACTIVITY | KPI | MILESTONE
  code         String? // "SO1", "Pillar 2"
  title        String
  description  String?
  owner        String?
  sortOrder    Int     @default(0) @map("sort_order")

  // KPI definition
  unit         String?
  baseline     Float?
  targetValue  Float?  @map("target_value")
  currentValue Float?  @map("current_value")
  direction    String? // increase | decrease
  frequency    String? // Annual | Quarterly | Monthly
  dataSource   String? @map("data_source")
  isFeatured   Boolean @default(false) @map("is_featured")

  // Activity / milestone schedule
  startDate DateTime? @map("start_date")
  endDate   DateTime? @map("end_date")
  budget    Float?
  status    String    @default("Planned") // Planned | In Progress | Completed | At Risk
  progress  Int       @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  plan            Plan             @relation(fields: [planId], references: [id], onDelete: Cascade)
  parent          PlanItem?        @relation("PlanItemTree", fields: [parentId], references: [id], onDelete: Cascade)
  children        PlanItem[]       @relation("PlanItemTree")
  linkedItem      PlanItem?        @relation("ItemAlignment", fields: [linkedItemId], references: [id], onDelete: SetNull)
  alignedItems    PlanItem[]       @relation("ItemAlignment")
  targets         PlanKpiTarget[]
  alerts          PlanAlert[]
  progressUpdates ProgressUpdate[]

  @@index([planId, parentId, sortOrder])
  @@index([linkedItemId])
  @@map("plan_item")
}

// Year-by-year (or quarter-by-quarter) target/actual readings for a KPI.
model PlanKpiTarget {
  id          String  @id @default(cuid())
  itemId      String  @map("item_id")
  periodLabel String  @map("period_label") // "2026", "Q4 2028"
  target      Float?
  targetLabel String? @map("target_label") // qualitative target, e.g. "ISO 13485 certified"
  actual      Float?
  note        String?

  item PlanItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, periodLabel])
  @@map("plan_kpi_target")
}

// Reporting obligation for a plan period (monthly, quarterly, annual...).
// A task owner's narrative + percentage update on a plan item for a period.
// The consolidated annual/strategic/roadmap reports read the latest of these.
model ProgressUpdate {
  id           String    @id @default(cuid())
  reference    String?   @unique
  planId       String    @map("plan_id")
  periodId     String?   @map("period_id")
  itemId       String    @map("item_id")
  periodLabel  String    @default("") @map("period_label")
  authorId     String    @map("author_id")
  authorName   String?   @map("author_name")
  progress     Int       @default(0)
  status       String    @default("Draft") // Draft | Submitted | Reviewed (legacy) | Verified
  summary      String
  achievements String?
  challenges   String?
  nextSteps    String?   @map("next_steps")
  reviewedBy   String?   @map("reviewed_by")
  reviewedAt   DateTime? @map("reviewed_at")
  reviewerNote String?   @map("reviewer_note")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  plan   Plan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  period PlanPeriod? @relation(fields: [periodId], references: [id], onDelete: SetNull)
  item   PlanItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, periodLabel])
  @@index([planId, periodLabel])
  @@index([periodId, status])
  @@index([authorId, status])
  @@map("progress_update")
}

model PlanReport {
  id          String    @id @default(cuid())
  planId      String    @map("plan_id")
  title       String
  type        String // MONTHLY | QUARTERLY | SEMI_ANNUAL | ANNUAL | AD_HOC
  periodLabel String    @map("period_label")
  dueDate     DateTime  @map("due_date")
  owner       String?
  status      String    @default("Pending") // Pending | Submitted | Approved | Waived
  submittedAt DateTime? @map("submitted_at")
  submittedBy String?   @map("submitted_by")
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  plan   Plan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  alerts PlanAlert[]

  @@index([planId, dueDate])
  @@index([status, dueDate])
  @@map("plan_report")
}

// Target-performance or reporting-deadline alert raised by the watch run.
model PlanAlert {
  id             String    @id @default(cuid())
  planId         String    @map("plan_id")
  itemId         String?   @map("item_id")
  reportId       String?   @map("report_id")
  dedupeKey      String    @unique @map("dedupe_key")
  periodLabel    String    @default("") @map("period_label")
  severity       String // INFO | WARNING | CRITICAL
  rule           String // TARGET_MISSED | BEHIND_PACE | DUE_SOON | OVERDUE | REPORT_DUE
  title          String
  message        String
  expected       Float?
  actual         Float?
  progress       Float?
  status         String    @default("Open") // Open | Acknowledged | Resolved
  emailsSent     Int       @default(0) @map("emails_sent")
  acknowledgedBy String?   @map("acknowledged_by")
  acknowledgedAt DateTime? @map("acknowledged_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  plan   Plan            @relation(fields: [planId], references: [id], onDelete: Cascade)
  item   PlanItem?       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  report PlanReport?     @relation(fields: [reportId], references: [id], onDelete: Cascade)
  mails  PlanAlertMail[]

  @@index([planId, status, createdAt])
  @@index([status, createdAt])
  @@map("plan_alert")
}

// Audit trail of every alert email attempt (SENT / SKIPPED / FAILED).
model PlanAlertMail {
  id        String   @id @default(cuid())
  alertId   String   @map("alert_id")
  to        String
  subject   String
  status    String // SENT | SKIPPED | FAILED
  error     String?
  createdAt DateTime @default(now()) @map("created_at")

  alert PlanAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("plan_alert_mail")
}

// Immutable snapshot captured at approval/publish (or manually).
model PlanRevision {
  id        String   @id @default(cuid())
  planId    String   @map("plan_id")
  revision  Int
  status    String
  note      String?
  snapshot  Json
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, createdAt])
  @@map("plan_revision")
}

// A restricted, token-based read-only link to one plan, with a comment channel.
model PlanShare {
  id           String    @id @default(cuid())
  planId       String    @map("plan_id")
  token        String    @unique
  label        String?
  isActive     Boolean   @default(true) @map("is_active")
  expiresAt    DateTime? @map("expires_at")
  createdBy    String    @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  lastViewedAt DateTime? @map("last_viewed_at")
  viewCount    Int       @default(0) @map("view_count")

  plan     Plan               @relation(fields: [planId], references: [id], onDelete: Cascade)
  comments PlanShareComment[]

  @@index([planId])
  @@map("plan_share")
}

model PlanShareComment {
  id          String   @id @default(cuid())
  shareId     String   @map("share_id")
  planId      String   @map("plan_id")
  authorName  String   @map("author_name")
  authorEmail String?  @map("author_email")
  body        String
  context     String?
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at")

  share PlanShare @relation(fields: [shareId], references: [id], onDelete: Cascade)

  @@index([planId, isRead, createdAt])
  @@map("plan_share_comment")
}

// Admin-editable runtime configuration (alert thresholds, recipients, etc.)
model AppSetting {
  key       String   @id
  value     Json
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_setting")
}

model VisitorLog {
  id        String   @id @default(cuid())
  ip        String
  visitedAt DateTime @default(now())
}

// Video items shown in the public "Media" section, managed from the admin panel.
model MediaVideo {
  id          String   @id @default(cuid())
  title       String
  titleAm     String?  @map("title_am")
  caption     String?
  captionAm   String?  @map("caption_am")
  videoUrl    String   @map("video_url")
  posterUrl   String?  @map("poster_url")
  captionsUrl String?  @map("captions_url")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("media_video")
}

// --- PHASE 2 HR MODELS ---

model Training {
  id             String    @id @default(cuid())
  userId         String
  title          String
  provider       String
  completedAt    DateTime
  expiresAt      DateTime?
  certificateUrl String?
  createdAt      DateTime  @default(now())
  user           User      @relation("UserTraining", fields: [userId], references: [id], onDelete: Cascade)
}

model LeaveRequest {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation("LeaveRequester", fields: [userId], references: [id], onDelete: Cascade)
  type            String // ANNUAL | SICK | MATERNITY | UNPAID
  startDate       DateTime
  endDate         DateTime
  status          String   @default("PENDING") // PENDING | APPROVED | REJECTED
  reason          String?
  rejectionReason String?
  supervisorId    String?
  supervisor      User?    @relation("LeaveSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  approvedById    String?
  approvedBy      User?    @relation("LeaveApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  // (removed duplicate user relation)
}

model AttendanceLog {
  id       String    @id @default(cuid())
  userId   String
  date     DateTime
  clockIn  DateTime?
  clockOut DateTime?
  status   String // PRESENT | ABSENT | LATE | HOLIDAY
  user     User      @relation("UserAttendance", fields: [userId], references: [id], onDelete: Cascade)
}

// --- LEAVE BALANCE MODELS ---

model LeaveType {
  id               String   @id @default(cuid())
  name             String   @unique // e.g., "Annual Leave", "Sick Leave"
  code             String   @unique // e.g., "ANNUAL", "SICK"
  shortCode        String?  @unique @map("short_code") // two-letter timesheet code, e.g. "AL", "SL", "AB"
  defaultDays      Int      @default(20)
  maxRolloverDays  Int      @default(5)
  rolloverExpireYr Int      @default(1)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
}

model LeaveBalance {
  id           String @id @default(cuid())
  userId       String
  year         Int
  leaveType    String @default("ANNUAL")
  entitledDays Float  @default(0)
  usedDays     Float  @default(0)
  rolloverDays Float  @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, leaveType])
}

// --- ANNUAL LEAVE PLANNING MODELS ---

model AnnualLeavePlan {
  id              String    @id @default(cuid())
  userId          String
  year            Int
  status          String    @default("DRAFT") // DRAFT | SUBMITTED | APPROVED | REJECTED | VERIFIED
  submittedAt     DateTime?
  supervisorId    String?
  supervisor      User?     @relation("PlanSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  approvedAt      DateTime?
  rejectionReason String?
  hrVerifiedAt    DateTime?
  createdAt       DateTime  @default(now())

  user  User                  @relation("UserAnnualPlans", fields: [userId], references: [id], onDelete: Cascade)
  items AnnualLeavePlanItem[]

  @@unique([userId, year])
}

model AnnualLeavePlanItem {
  id        String   @id @default(cuid())
  planId    String
  startDate DateTime
  endDate   DateTime
  days      Int
  leaveType String   @default("ANNUAL")
  notes     String?

  plan AnnualLeavePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
}

// --- PUBLIC HOLIDAYS MODEL ---
model PublicHoliday {
  id        String   @id @default(cuid())
  name      String
  date      DateTime @unique
  year      Int // Ethiopian Fiscal Year or Gregorian Year depending on preference
  createdAt DateTime @default(now())
}

// --- TIMESHEET MODELS ---

model Timesheet {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation("UserTimesheets", fields: [userId], references: [id], onDelete: Cascade)
  month           Int // 1-12
  year            Int
  status          String    @default("DRAFT") // DRAFT | SUBMITTED | APPROVED | REJECTED
  supervisorId    String?
  supervisor      User?     @relation("TimesheetSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  rejectionReason String?
  submittedAt     DateTime?
  approvedAt      DateTime?
  createdAt       DateTime  @default(now())

  entries TimesheetEntry[]

  @@unique([userId, month, year])
}

model TimesheetEntry {
  id          String    @id @default(cuid())
  timesheetId String
  timesheet   Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  date        DateTime
  hours       Float
  leaveCode   String?   @map("leave_code") // absence marker such as AL, SL, AB (hours then 0)
  projectId   String? // Optional link to Project
  projectName String?   @map("project_name")
  description String?
}

model TimesheetSetting {
  id            String   @id @default(cuid())
  submissionDay Int      @default(25) // Day of month deadline
  updatedAt     DateTime @updatedAt
}

// --- RECRUITMENT MODELS ---
model JobPosting {
  id                 String              @id @default(cuid())
  title              String
  department         String
  summary            String?
  description        String?
  requirements       String?
  responsibilities   String?
  location           String?             @default("Kilinto, Addis Ababa")
  employmentType     String?             @default("FULL_TIME") // FULL_TIME | PART_TIME | CONTRACT | INTERNSHIP
  openings           Int                 @default(1)
  status             String              @default("DRAFT") // DRAFT | OPEN | CLOSED | FILLED
  closesAt           DateTime?
  publishedAt        DateTime?
  targetHire         DateTime?
  createdAt          DateTime            @default(now())
  applicants         Applicant[]
  recruitmentRequest RecruitmentRequest?
}

model Applicant {
  id              String     @id @default(cuid())
  jobId           String
  job             JobPosting @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name            String
  email           String
  phone           String?
  source          String?
  stage           String     @default("APPLIED") // APPLIED | SCREENING | INTERVIEW | OFFER | HIRED | REJECTED | ON_HOLD
  rating          Int?
  notes           String?
  coverLetter     String?
  resumeUrl       String?
  interviewAt     DateTime?
  rejectionReason String?
  hiredAt         DateTime?
  userId          String?    @map("user_id")
  stageUpdatedAt  DateTime   @default(now()) @map("stage_updated_at")
  createdAt       DateTime   @default(now())
}

// A monthly payslip snapshot generated from the payroll register.
model Payslip {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  year            Int
  month           Int
  baseSalary      Float     @map("base_salary")
  allowance       Float     @default(0)
  otherEarnings   Float     @default(0) @map("other_earnings")
  gross           Float
  pension         Float
  tax             Float
  otherDeductions Float     @default(0) @map("other_deductions")
  net             Float
  currency        String    @default("ETB")
  status          String    @default("Generated") // Generated | Sent
  sentAt          DateTime? @map("sent_at")
  sentTo          String?   @map("sent_to")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@unique([userId, year, month])
  @@index([year, month])
  @@map("payslip")
}

// --- PAYROLL MODEL ---
model SalaryRecord {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  baseSalary      Float
  allowance       Float     @default(0)
  otherEarnings   Float     @default(0)
  otherDeductions Float     @default(0)
  currency        String    @default("ETB")
  effectiveAt     DateTime  @default(now())
  notes           String?
  approvalStatus  String    @default("Approved") @map("approval_status")
  submittedBy     String?   @map("submitted_by")
  submittedAt     DateTime  @default(now()) @map("submitted_at")
  approvedBy      String?   @map("approved_by")
  approvedAt      DateTime? @map("approved_at")
  approvalNote    String?   @map("approval_note")

  @@index([approvalStatus, effectiveAt])
}

// Audit trail for bulk CSV imports, including enough snapshot data to roll back.
model ImportBatch {
  id           String    @id @default(cuid())
  module       String
  planId       String?   @map("plan_id")
  userId       String    @map("user_id")
  userName     String?   @map("user_name")
  fileName     String?   @map("file_name")
  summary      Json
  snapshot     Json
  rolledBackAt DateTime? @map("rolled_back_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([module, createdAt])
  @@index([planId, createdAt])
  @@map("import_batch")
}

// Recurring consolidated-report distribution. The server's daily maintenance
// job checks nextRunAt and emails the report link when SMTP is configured.
model ReportSchedule {
  id         String    @id @default(cuid())
  type       String
  planId     String?   @map("plan_id")
  recipients String[]  @default([])
  frequency  String    @default("MONTHLY")
  enabled    Boolean   @default(true)
  lastRunAt  DateTime? @map("last_run_at")
  nextRunAt  DateTime  @map("next_run_at")
  createdBy  String    @map("created_by")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([enabled, nextRunAt])
  @@map("report_schedule")
}

// --- STAFF SELF-SERVICE: TASKS & DOCUMENTS ---

model StaffTask {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  user        User      @relation("UserStaffTasks", fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  priority    String    @default("NORMAL") // LOW | NORMAL | HIGH
  dueAt       DateTime? @map("due_at")
  status      String    @default("OPEN") // OPEN | DONE
  link        String?
  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")
  // Supervisor assignment and two-way progress exchange.
  assignedById   String?   @map("assigned_by_id")
  assignedByName String?   @map("assigned_by_name")
  progress       Int       @default(0)
  latestUpdate   String?   @map("latest_update")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  updates        StaffTaskUpdate[]

  @@index([userId, status, dueAt])
  @@index([assignedById, status])
  @@map("staff_task")
}

// A timestamped progress note on a task, visible to the assignee and the
// supervisor who assigned it. The task keeps the latest note for list views.
model StaffTaskUpdate {
  id         String   @id @default(cuid())
  taskId     String   @map("task_id")
  task       StaffTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId   String   @map("author_id")
  authorName String?  @map("author_name")
  progress   Int?
  note       String
  status     String? // OPEN | DONE snapshot at the time of the note
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([taskId, createdAt])
  @@map("staff_task_update")
}

model StaffDocument {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  user          User      @relation("UserStaffDocuments", fields: [userId], references: [id], onDelete: Cascade)
  title         String
  category      String    @default("OTHER") // CONTRACT | ID | LICENCE | CERTIFICATE | MEDICAL | OTHER
  reference     String?   @unique
  issuedAt      DateTime? @map("issued_at")
  expiresAt     DateTime? @map("expires_at")
  fileUrl       String?   @map("file_url")
  notes         String?
  signatureName String?   @map("signature_name")
  signedAt      DateTime? @map("signed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([userId, expiresAt])
  @@map("staff_document")
}

// Atomic counters behind human-readable document references. A row is created
// on first use, then incremented inside a transaction so two simultaneous
// uploads can never receive the same number.
model NumberSequence {
  id        String   @id @default(cuid())
  scope     String
  year      Int
  value     Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([scope, year])
  @@map("number_sequence")
}

// --- INDUCTION ---

model Induction {
  id          String          @id @default(cuid())
  userId      String          @map("user_id")
  user        User            @relation("UserInduction", fields: [userId], references: [id], onDelete: Cascade)
  startDate   DateTime        @map("start_date")
  status      String          @default("ACTIVE") // ACTIVE | COMPLETED
  completedAt DateTime?       @map("completed_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  tasks       InductionTask[]

  @@index([userId])
  @@map("induction")
}

model InductionTask {
  id          String    @id @default(cuid())
  inductionId String    @map("induction_id")
  induction   Induction @relation(fields: [inductionId], references: [id], onDelete: Cascade)
  title       String
  category    String    @default("GENERAL") // DOCUMENTS | IT | COMPLIANCE | MEETINGS | TRAINING | GENERAL
  dueAt       DateTime? @map("due_at")
  completedAt DateTime? @map("completed_at")
  notes       String?
  sortOrder   Int       @default(0) @map("sort_order")

  @@map("induction_task")
}

// --- RECRUITMENT REQUISITIONS, JOB DESCRIPTIONS & E-SIGNATURES ---

model RecruitmentRequest {
  id              String      @id @default(cuid())
  requestNumber   String      @unique @map("request_number")
  requestedById   String      @map("requested_by_id")
  requestedBy     User        @relation("RecruitmentRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  positionTitle   String      @map("position_title")
  department      String
  employmentType  String      @default("FULL_TIME") @map("employment_type")
  positions       Int         @default(1)
  reason          String      @default("NEW") // NEW | REPLACEMENT | TEMPORARY
  grade           String?
  budgetStatus    String      @default("BUDGETED") @map("budget_status") // BUDGETED | UNBUDGETED | APPROVED
  targetStartDate DateTime?   @map("target_start_date")
  justification   String?
  requirements    String?
  status          String      @default("DRAFT") // DRAFT | SUBMITTED | APPROVED | REJECTED | FULFILLED
  approverId      String?     @map("approver_id")
  approver        User?       @relation("RecruitmentApprover", fields: [approverId], references: [id], onDelete: SetNull)
  decidedAt       DateTime?   @map("decided_at")
  rejectionReason String?     @map("rejection_reason")
  jobPostingId    String?     @unique @map("job_posting_id")
  jobPosting      JobPosting? @relation(fields: [jobPostingId], references: [id], onDelete: SetNull)
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("recruitment_request")
}

model JobDescription {
  id            String                     @id @default(cuid())
  title         String
  department    String?
  position      String?
  summary       String?
  version       String                     @default("1.0")
  effectiveDate DateTime?                  @map("effective_date")
  fileName      String                     @map("file_name")
  filePath      String                     @map("file_path")
  fileSize      Int                        @default(0) @map("file_size")
  mimeType      String                     @default("application/pdf") @map("mime_type")
  uploadedById  String?                    @map("uploaded_by_id")
  uploadedBy    User?                      @relation("JobDescriptionUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  status        String                     @default("ACTIVE") // ACTIVE | ARCHIVED
  createdAt     DateTime                   @default(now()) @map("created_at")
  updatedAt     DateTime                   @updatedAt @map("updated_at")
  assignments   JobDescriptionAssignment[]

  @@index([status, createdAt])
  @@map("job_description")
}

model JobDescriptionAssignment {
  id               String         @id @default(cuid())
  jobDescriptionId String         @map("job_description_id")
  jobDescription   JobDescription @relation(fields: [jobDescriptionId], references: [id], onDelete: Cascade)
  userId           String         @map("user_id")
  user             User           @relation("UserJobDescriptions", fields: [userId], references: [id], onDelete: Cascade)
  assignedById     String?        @map("assigned_by_id")
  assignedBy       User?          @relation("JobDescriptionAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  assignedAt       DateTime       @default(now()) @map("assigned_at")
  viewedAt         DateTime?      @map("viewed_at")
  acknowledgedAt   DateTime?      @map("acknowledged_at")

  @@unique([jobDescriptionId, userId])
  @@index([userId, acknowledgedAt])
  @@map("job_description_assignment")
}

model SignatureRecord {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  user         User     @relation("UserSignatures", fields: [userId], references: [id], onDelete: Cascade)
  entityType   String   @map("entity_type") // STAFF_DOCUMENT | LEAVE_REQUEST | TIMESHEET | ANNUAL_PLAN | RECRUITMENT_REQUEST | JOB_DESCRIPTION | OFFBOARDING
  entityId     String   @map("entity_id")
  decision     String // SUBMITTED | APPROVED | REJECTED | SIGNED | ACKNOWLEDGED
  signedName   String   @map("signed_name")
  signatureUrl String?  @map("signature_url")
  initialsUrl  String?  @map("initials_url")
  initialsText String?  @map("initials_text")
  note         String?
  signedAt     DateTime @default(now()) @map("signed_at")

  @@index([entityType, entityId])
  @@index([userId, signedAt])
  @@map("signature_record")
}

// --- OFFBOARDING / EXIT MANAGEMENT ---

model OffboardingCase {
  id                     String            @id @default(cuid())
  userId                 String            @map("user_id")
  user                   User              @relation("UserOffboarding", fields: [userId], references: [id], onDelete: Cascade)
  initiatedById          String            @map("initiated_by_id")
  initiatedBy            User              @relation("OffboardingInitiator", fields: [initiatedById], references: [id], onDelete: Restrict)
  managerId              String?           @map("manager_id")
  manager                User?             @relation("OffboardingManager", fields: [managerId], references: [id], onDelete: SetNull)
  reason                 String            @default("RESIGNATION") // RESIGNATION | TERMINATION | RETIREMENT | CONTRACT_END | OTHER
  status                 String            @default("INITIATED") // SUBMITTED | INITIATED | IN_PROGRESS | READY_FOR_EXIT | COMPLETED | WITHDRAWN
  noticeDate             DateTime?         @map("notice_date")
  lastWorkingDay         DateTime          @map("last_working_day")
  // Employee-filed resignation: the snapshot of the HR notice period applied at
  // submission, plus the note and the moment it was filed.
  resignationSubmittedAt DateTime?         @map("resignation_submitted_at")
  resignationNote        String?           @map("resignation_note")
  noticePeriodDays       Int?              @map("notice_period_days")
  acceptedAt             DateTime?         @map("accepted_at")
  exitInterviewAt        DateTime?         @map("exit_interview_at")
  exitInterviewNotes     String?           @map("exit_interview_notes")
  handoverNotes          String?           @map("handover_notes")
  finalSettlementAmount  Float?            @map("final_settlement_amount")
  settlementStatus       String            @default("PENDING") @map("settlement_status") // PENDING | CALCULATED | PAID
  eligibleForRehire      Boolean?          @map("eligible_for_rehire")
  employeeAcknowledgedAt DateTime?         @map("employee_acknowledged_at")
  hrApprovedAt           DateTime?         @map("hr_approved_at")
  completedAt            DateTime?         @map("completed_at")
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @updatedAt @map("updated_at")
  tasks                  OffboardingTask[]

  @@index([userId, status])
  @@index([status, lastWorkingDay])
  @@map("offboarding_case")
}

model OffboardingTask {
  id          String          @id @default(cuid())
  caseId      String          @map("case_id")
  case        OffboardingCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  title       String
  category    String          @default("GENERAL") // HANDOVER | ASSETS | ACCESS | FINANCE | HR | EXIT
  owner       String          @default("HR")
  dueAt       DateTime?       @map("due_at")
  completedAt DateTime?       @map("completed_at")
  completedBy String?         @map("completed_by")
  notes       String?
  sortOrder   Int             @default(0) @map("sort_order")

  @@index([caseId, sortOrder])
  @@map("offboarding_task")
}

// --- PERFORMANCE MANAGEMENT ---

model Appraisal {
  id             String          @id @default(cuid())
  userId         String          @map("user_id")
  user           User            @relation("UserAppraisals", fields: [userId], references: [id], onDelete: Cascade)
  cycle          String // e.g. "2026-H2"
  periodLabel    String          @map("period_label")
  periodStart    DateTime        @map("period_start")
  periodEnd      DateTime        @map("period_end")
  status         String          @default("DRAFT") // DRAFT | SELF_SUBMITTED | MANAGER_REVIEWED | COMPLETED
  selfSummary    String?         @map("self_summary")
  managerSummary String?         @map("manager_summary")
  selfRating     Float?          @map("self_rating")
  managerRating  Float?          @map("manager_rating")
  submittedAt    DateTime?       @map("submitted_at")
  reviewedAt     DateTime?       @map("reviewed_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  items          AppraisalItem[]

  @@unique([userId, cycle])
  @@map("appraisal")
}

model AppraisalItem {
  id           String    @id @default(cuid())
  appraisalId  String    @map("appraisal_id")
  appraisal    Appraisal @relation(fields: [appraisalId], references: [id], onDelete: Cascade)
  title        String
  weight       Int       @default(20)
  selfScore    Float?    @map("self_score")
  managerScore Float?    @map("manager_score")
  comment      String?
  sortOrder    Int       @default(0) @map("sort_order")

  @@map("appraisal_item")
}

// ============================================================
// FLEET & TRANSPORT
// Vehicles, drivers, requests (2-stage approval), ride-service
// alternative, and settings. Added for Ethio-Biopharma.
// ============================================================

model Vehicle {
  id               String    @id @default(cuid())
  vehicleCode      String    @unique // "V001"
  type             String // Sedan | 4x4 | Minibus | Ambulance | Truck | Motorcycle
  licensePlate     String    @unique
  capacity         Int
  assignedDriverId String?   @map("assigned_driver_id")
  assignedDriver   Driver?   @relation("VehicleDriver", fields: [assignedDriverId], references: [id], onDelete: SetNull)
  status           String    @default("Available") // Available | In Use | Under Maintenance | Unavailable
  lastMaintenance  DateTime? @map("last_maintenance")
  nextMaintenance  DateTime? @map("next_maintenance")
  odometer         Float?
  fuelType         String?   @map("fuel_type") // Petrol | Diesel | Electric | Hybrid
  remarks          String?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  requests VehicleRequest[]

  @@index([status])
  @@map("vehicle")
}

model Driver {
  id            String    @id @default(cuid())
  driverCode    String    @unique // "D001"
  name          String
  phone         String
  email         String?
  userId        String?   @unique @map("user_id") // optional link to User (hybrid Q6c)
  user          User?     @relation("DriverUser", fields: [userId], references: [id], onDelete: SetNull)
  status        String    @default("Available") // Available | On Leave | Suspended
  licenseExpiry DateTime? @map("license_expiry")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  vehicles Vehicle[]        @relation("VehicleDriver")
  requests VehicleRequest[] @relation("VehicleRequestDriver")

  @@index([status])
  @@map("driver")
}

model VehicleRequest {
  id                   String    @id @default(cuid())
  requestCode          String    @unique // "REQ-20261110-0001"
  requesterId          String    @map("requester_id")
  requester            User      @relation("VehicleRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  requestType          String    @map("request_type") // In-Town | Field
  tripPurpose          String    @map("trip_purpose")
  directorate          String?
  division             String?
  vehicleTypePreferred String?   @map("vehicle_type_preferred")
  passengers           Int       @default(1)
  departureDate        DateTime  @map("departure_date")
  returnDate           DateTime  @map("return_date")
  departureTime        String    @map("departure_time")
  returnTime           String?   @map("return_time")
  pickupLocation       String    @map("pickup_location")
  destination          String
  distance             Float?
  odometerStart        Float?    @map("odometer_start")
  odometerEnd          Float?    @map("odometer_end")
  status               String    @default("PENDING")
  // PENDING | SUPERVISOR_APPROVED | FLEET_APPROVED | ASSIGNED | IN_PROGRESS | COMPLETED | REJECTED | CANCELLED | EXPIRED
  supervisorId         String?   @map("supervisor_id")
  supervisor           User?     @relation("VehicleRequestSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  fleetApproverId      String?   @map("fleet_approver_id")
  fleetApprover        User?     @relation("VehicleRequestFleetApprover", fields: [fleetApproverId], references: [id], onDelete: SetNull)
  vehicleId            String?   @map("vehicle_id")
  vehicle              Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driverId             String?   @map("driver_id")
  driver               Driver?   @relation("VehicleRequestDriver", fields: [driverId], references: [id], onDelete: SetNull)
  rejectionReason      String?   @map("rejection_reason")
  gatePassNo           String?   @map("gate_pass_no")
  gatePassSentAt       DateTime? @map("gate_pass_sent_at")
  remarks              String?
  requestedAt          DateTime  @default(now()) @map("requested_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  rideRequests RideRequest[]

  @@index([status, departureDate])
  @@index([requesterId, requestedAt])
  @@index([supervisorId, status])
  @@map("vehicle_request")
}

model RideProvider {
  id           String   @id @default(cuid())
  name         String   @unique // "Ride", "ZayRide", "Feres", etc.
  contactName  String?  @map("contact_name")
  contactPhone String?  @map("contact_phone")
  contactEmail String?  @map("contact_email")
  pricingNote  String?  @map("pricing_note")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  rideRequests RideRequest[]

  @@map("ride_provider")
}

model RideRequest {
  id                     String          @id @default(cuid())
  requestCode            String          @unique // "RIDE-20261110-0001"
  requesterId            String          @map("requester_id")
  requester              User            @relation("RideRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  linkedVehicleRequestId String?         @map("linked_vehicle_request_id")
  linkedVehicleRequest   VehicleRequest? @relation(fields: [linkedVehicleRequestId], references: [id], onDelete: SetNull)
  tripPurpose            String          @map("trip_purpose")
  pickupLocation         String          @map("pickup_location")
  destination            String
  departureDate          DateTime        @map("departure_date")
  departureTime          String          @map("departure_time")
  returnTime             String?         @map("return_time")
  passengers             Int             @default(1)
  providerId             String?         @map("provider_id")
  provider               RideProvider?   @relation(fields: [providerId], references: [id], onDelete: SetNull)
  estimatedFare          Float?          @map("estimated_fare")
  actualFare             Float?          @map("actual_fare")
  currency               String          @default("ETB")
  receiptUrl             String?         @map("receipt_url")
  status                 String          @default("PENDING")
  // PENDING | SUPERVISOR_APPROVED | FLEET_APPROVED | ASSIGNED | COMPLETED | REJECTED | CANCELLED
  supervisorId           String?         @map("supervisor_id")
  supervisor             User?           @relation("RideSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  approverId             String?         @map("approver_id")
  approver               User?           @relation("RideApprover", fields: [approverId], references: [id], onDelete: SetNull)
  rejectionReason        String?         @map("rejection_reason")
  remarks                String?
  requestedAt            DateTime        @default(now()) @map("requested_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")

  @@index([status, departureDate])
  @@index([requesterId, requestedAt])
  @@index([supervisorId, status])
  @@map("ride_request")
}

model FleetSetting {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("fleet_setting")
}

// ============================================================
// QMS — QUALITY MANAGEMENT SYSTEM
// WHO-aligned document control module.
// ============================================================

model QmsDocument {
  id              String        @id @default(cuid())
  code            String // "SOP-QA-001" (document family; unique per version)
  title           String
  titleAm         String?       @map("title_am")
  description     String?
  category        String // SOP | Specification | Protocol | Record | Policy | Work Instruction | Form
  department      String? // QA | Production | QC | Warehouse | Engineering | Regulatory | HR | IT
  version         String        @default("1.0") // "1.0", "2.1"
  status          String        @default("DRAFT") // DRAFT | IN_REVIEW | APPROVED | SUPERSEDED | OBSOLETE
  ownerId         String        @map("owner_id")
  owner           User          @relation("QmsDocumentOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  reviewerId      String?       @map("reviewer_id")
  reviewer        User?         @relation("QmsDocumentReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  approverId      String?       @map("approver_id")
  approver        User?         @relation("QmsDocumentApprover", fields: [approverId], references: [id], onDelete: SetNull)
  fileUrl         String?       @map("file_url")
  fileName        String?       @map("file_name")
  fileSize        Int?          @map("file_size")
  effectiveDate   DateTime?     @map("effective_date")
  reviewDueAt     DateTime?     @map("review_due_at")
  approvedAt      DateTime?     @map("approved_at")
  supersededAt    DateTime?     @map("superseded_at")
  supersededById  String?       @map("superseded_by_id")
  supersededBy    QmsDocument?  @relation("QmsSupersession", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes      QmsDocument[] @relation("QmsSupersession")
  changeSummary   String?       @map("change_summary")
  rejectionReason String?       @map("rejection_reason")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@unique([code, version])
  @@index([code])
  @@index([status, category])
  @@index([department])
  @@index([ownerId])
  @@index([effectiveDate])
  @@map("qms_document")
}

// ============================================================
// QMS — DEVIATIONS, CAPA AND CHANGE CONTROL
// Completes the WHO quality-event lifecycle beyond document control.
// ============================================================

model QmsDeviation {
  id              String    @id @default(cuid())
  code            String    @unique
  title           String
  description     String
  category        String    @default("Process") // Product | Process | Equipment | Document | Supplier | Other
  severity        String    @default("Minor") // Critical | Major | Minor
  source          String    @default("Internal") // Internal | Audit | Complaint | Supplier | Regulatory | Customer
  department      String?
  detectedAt      DateTime  @default(now()) @map("detected_at")
  reportedById    String    @map("reported_by_id")
  reportedBy      User      @relation("QmsDeviationReporter", fields: [reportedById], references: [id], onDelete: Restrict)
  ownerId         String    @map("owner_id")
  owner           User      @relation("QmsDeviationOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  status          String    @default("OPEN") // OPEN | UNDER_INVESTIGATION | CLOSED
  immediateAction String?   @map("immediate_action")
  rootCause       String?   @map("root_cause")
  investigation   String?
  closureNotes    String?   @map("closure_notes")
  dueAt           DateTime? @map("due_at")
  closedAt        DateTime? @map("closed_at")
  closedById      String?   @map("closed_by_id")
  closedBy        User?     @relation("QmsDeviationCloser", fields: [closedById], references: [id], onDelete: SetNull)
  capas           QmsCapa[] @relation("QmsCapaDeviation")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([status, severity])
  @@index([department])
  @@index([ownerId])
  @@index([detectedAt])
  @@map("qms_deviation")
}

model QmsCapa {
  id                 String        @id @default(cuid())
  code               String        @unique
  title              String
  type               String        @default("Corrective") // Corrective | Preventive
  sourceType         String        @default("Deviation") // Deviation | Change | Audit | Complaint | Other
  sourceRef          String?       @map("source_ref")
  description        String
  rootCause          String?       @map("root_cause")
  actionPlan         String?       @map("action_plan")
  department         String?
  ownerId            String        @map("owner_id")
  owner              User          @relation("QmsCapaOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  status             String        @default("OPEN") // OPEN | IN_PROGRESS | PENDING_VERIFICATION | CLOSED
  dueAt              DateTime?     @map("due_at")
  effectivenessCheck String?       @map("effectiveness_check")
  verifiedById       String?       @map("verified_by_id")
  verifiedBy         User?         @relation("QmsCapaVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt         DateTime?     @map("verified_at")
  closedAt           DateTime?     @map("closed_at")
  deviationId        String?       @map("deviation_id")
  deviation          QmsDeviation? @relation("QmsCapaDeviation", fields: [deviationId], references: [id], onDelete: SetNull)
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  @@index([status, dueAt])
  @@index([ownerId])
  @@index([deviationId])
  @@map("qms_capa")
}

model QmsChangeControl {
  id                 String    @id @default(cuid())
  code               String    @unique
  title              String
  description        String
  reason             String
  category           String    @default("Process") // Document | Process | Equipment | Facility | System | Supplier
  riskLevel          String    @default("Medium") // High | Medium | Low
  department         String?
  ownerId            String    @map("owner_id")
  owner              User      @relation("QmsChangeOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  status             String    @default("DRAFT") // DRAFT | IN_REVIEW | APPROVED | IMPLEMENTED | CLOSED | REJECTED
  impactAssessment   String?   @map("impact_assessment")
  implementationPlan String?   @map("implementation_plan")
  effectiveDate      DateTime? @map("effective_date")
  relatedDocument    String?   @map("related_document")
  approvedById       String?   @map("approved_by_id")
  approvedBy         User?     @relation("QmsChangeApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt         DateTime? @map("approved_at")
  implementedAt      DateTime? @map("implemented_at")
  closedAt           DateTime? @map("closed_at")
  closureNotes       String?   @map("closure_notes")
  rejectionReason    String?   @map("rejection_reason")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@index([status, riskLevel])
  @@index([department])
  @@index([ownerId])
  @@index([effectiveDate])
  @@map("qms_change_control")
}
