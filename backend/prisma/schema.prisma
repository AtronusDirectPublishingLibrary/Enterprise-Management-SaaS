// A monthly payslip snapshot generated from the payroll register.
model Payslip {
  tenantId        String?   @map("tenant_id")
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  year            Int
  month           Int
  baseSalary      Float     @map("base_salary")
  allowance       Float     @default(0)
  otherEarnings   Float     @default(0) @map("other_earnings")
  gross           Float
  pension         Float
  tax             Float
  otherDeductions Float     @default(0) @map("other_deductions")
  net             Float
  currency        String    @default("ETB")
  status          String    @default("Generated") // Generated | Sent
  sentAt          DateTime? @map("sent_at")
  sentTo          String?   @map("sent_to")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@unique([userId, year, month])
  @@index([year, month])
  @@index([tenantId])
  @@map("payslip")
}

// --- PAYROLL MODEL ---
model SalaryRecord {
  tenantId        String?   @map("tenant_id")
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  baseSalary      Float
  allowance       Float     @default(0)
  otherEarnings   Float     @default(0)
  otherDeductions Float     @default(0)
  currency        String    @default("ETB")
  effectiveAt     DateTime  @default(now())
  notes           String?
  approvalStatus  String    @default("Approved") @map("approval_status")
  submittedBy     String?   @map("submitted_by")
  submittedAt     DateTime  @default(now()) @map("submitted_at")
  approvedBy      String?   @map("approved_by")
  approvedAt      DateTime? @map("approved_at")
  approvalNote    String?   @map("approval_note")

  @@index([approvalStatus, effectiveAt])
  @@index([tenantId])
}

// Audit trail for bulk CSV imports, including enough snapshot data to roll back.
model ImportBatch {
  tenantId     String?   @map("tenant_id")
  id           String    @id @default(cuid())
  module       String
  planId       String?   @map("plan_id")
  userId       String    @map("user_id")
  userName     String?   @map("user_name")
  fileName     String?   @map("file_name")
  summary      Json
  snapshot     Json
  rolledBackAt DateTime? @map("rolled_back_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([module, createdAt])
  @@index([planId, createdAt])
  @@index([tenantId])
  @@map("import_batch")
}

// Recurring consolidated-report distribution. The server's daily maintenance
// job checks nextRunAt and emails the report link when SMTP is configured.
model ReportSchedule {
  tenantId   String?   @map("tenant_id")
  id         String    @id @default(cuid())
  type       String
  planId     String?   @map("plan_id")
  recipients String[]  @default([])
  frequency  String    @default("MONTHLY")
  enabled    Boolean   @default(true)
  lastRunAt  DateTime? @map("last_run_at")
  nextRunAt  DateTime  @map("next_run_at")
  createdBy  String    @map("created_by")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([enabled, nextRunAt])
  @@index([tenantId])
  @@map("report_schedule")
}

// --- STAFF SELF-SERVICE: TASKS & DOCUMENTS ---

model StaffTask {
  tenantId       String?           @map("tenant_id")
  id             String            @id @default(cuid())
  userId         String            @map("user_id")
  user           User              @relation("UserStaffTasks", fields: [userId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  priority       String            @default("NORMAL") // LOW | NORMAL | HIGH
  dueAt          DateTime?         @map("due_at")
  status         String            @default("OPEN") // OPEN | DONE
  link           String?
  createdAt      DateTime          @default(now()) @map("created_at")
  completedAt    DateTime?         @map("completed_at")
  // Supervisor assignment and two-way progress exchange.
  assignedById   String?           @map("assigned_by_id")
  assignedByName String?           @map("assigned_by_name")
  progress       Int               @default(0)
  latestUpdate   String?           @map("latest_update")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  updates        StaffTaskUpdate[]

  @@index([userId, status, dueAt])
  @@index([assignedById, status])
  @@index([tenantId])
  @@map("staff_task")
}

// A timestamped progress note on a task, visible to the assignee and the
// supervisor who assigned it. The task keeps the latest note for list views.
model StaffTaskUpdate {
  tenantId   String?   @map("tenant_id")
  id         String    @id @default(cuid())
  taskId     String    @map("task_id")
  task       StaffTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId   String    @map("author_id")
  authorName String?   @map("author_name")
  progress   Int?
  note       String
  status     String? // OPEN | DONE snapshot at the time of the note
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([taskId, createdAt])
  @@index([tenantId])
  @@map("staff_task_update")
}

model StaffDocument {
  tenantId      String?   @map("tenant_id")
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  user          User      @relation("UserStaffDocuments", fields: [userId], references: [id], onDelete: Cascade)
  title         String
  category      String    @default("OTHER") // CONTRACT | ID | LICENCE | CERTIFICATE | MEDICAL | OTHER
  reference     String?   @unique
  issuedAt      DateTime? @map("issued_at")
  expiresAt     DateTime? @map("expires_at")
  fileUrl       String?   @map("file_url")
  notes         String?
  signatureName String?   @map("signature_name")
  signedAt      DateTime? @map("signed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([userId, expiresAt])
  @@index([tenantId])
  @@map("staff_document")
}

// Atomic counters behind human-readable document references. A row is created
// on first use, then incremented inside a transaction so two simultaneous
// uploads can never receive the same number.
model NumberSequence {
  tenantId  String?  @map("tenant_id")
  id        String   @id @default(cuid())
  scope     String
  year      Int
  value     Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([scope, year])
  @@index([tenantId])
  @@map("number_sequence")
}

// --- INDUCTION ---

model Induction {
  tenantId    String?         @map("tenant_id")
  id          String          @id @default(cuid())
  userId      String          @map("user_id")
  user        User            @relation("UserInduction", fields: [userId], references: [id], onDelete: Cascade)
  startDate   DateTime        @map("start_date")
  status      String          @default("ACTIVE") // ACTIVE | COMPLETED
  completedAt DateTime?       @map("completed_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  tasks       InductionTask[]

  @@index([userId])
  @@index([tenantId])
  @@map("induction")
}

model InductionTask {
  tenantId    String?   @map("tenant_id")
  id          String    @id @default(cuid())
  inductionId String    @map("induction_id")
  induction   Induction @relation(fields: [inductionId], references: [id], onDelete: Cascade)
  title       String
  category    String    @default("GENERAL") // DOCUMENTS | IT | COMPLIANCE | MEETINGS | TRAINING | GENERAL
  dueAt       DateTime? @map("due_at")
  completedAt DateTime? @map("completed_at")
  notes       String?
  sortOrder   Int       @default(0) @map("sort_order")

  @@index([tenantId])
  @@map("induction_task")
}

// --- RECRUITMENT REQUISITIONS, JOB DESCRIPTIONS & E-SIGNATURES ---

model RecruitmentRequest {
  tenantId        String?     @map("tenant_id")
  id              String      @id @default(cuid())
  requestNumber   String      @unique @map("request_number")
  requestedById   String      @map("requested_by_id")
  requestedBy     User        @relation("RecruitmentRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  positionTitle   String      @map("position_title")
  department      String
  employmentType  String      @default("FULL_TIME") @map("employment_type")
  positions       Int         @default(1)
  reason          String      @default("NEW") // NEW | REPLACEMENT | TEMPORARY
  grade           String?
  budgetStatus    String      @default("BUDGETED") @map("budget_status") // BUDGETED | UNBUDGETED | APPROVED
  targetStartDate DateTime?   @map("target_start_date")
  justification   String?
  requirements    String?
  status          String      @default("DRAFT") // DRAFT | SUBMITTED | APPROVED | REJECTED | FULFILLED
  approverId      String?     @map("approver_id")
  approver        User?       @relation("RecruitmentApprover", fields: [approverId], references: [id], onDelete: SetNull)
  decidedAt       DateTime?   @map("decided_at")
  rejectionReason String?     @map("rejection_reason")
  jobPostingId    String?     @unique @map("job_posting_id")
  jobPosting      JobPosting? @relation(fields: [jobPostingId], references: [id], onDelete: SetNull)
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([tenantId])
  @@map("recruitment_request")
}

model JobDescription {
  tenantId      String?                    @map("tenant_id")
  id            String                     @id @default(cuid())
  title         String
  department    String?
  position      String?
  summary       String?
  version       String                     @default("1.0")
  effectiveDate DateTime?                  @map("effective_date")
  fileName      String                     @map("file_name")
  filePath      String                     @map("file_path")
  fileSize      Int                        @default(0) @map("file_size")
  mimeType      String                     @default("application/pdf") @map("mime_type")
  uploadedById  String?                    @map("uploaded_by_id")
  uploadedBy    User?                      @relation("JobDescriptionUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  status        String                     @default("ACTIVE") // ACTIVE | ARCHIVED
  createdAt     DateTime                   @default(now()) @map("created_at")
  updatedAt     DateTime                   @updatedAt @map("updated_at")
  assignments   JobDescriptionAssignment[]

  @@index([status, createdAt])
  @@index([tenantId])
  @@map("job_description")
}

model JobDescriptionAssignment {
  tenantId         String?        @map("tenant_id")
  id               String         @id @default(cuid())
  jobDescriptionId String         @map("job_description_id")
  jobDescription   JobDescription @relation(fields: [jobDescriptionId], references: [id], onDelete: Cascade)
  userId           String         @map("user_id")
  user             User           @relation("UserJobDescriptions", fields: [userId], references: [id], onDelete: Cascade)
  assignedById     String?        @map("assigned_by_id")
  assignedBy       User?          @relation("JobDescriptionAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  assignedAt       DateTime       @default(now()) @map("assigned_at")
  viewedAt         DateTime?      @map("viewed_at")
  acknowledgedAt   DateTime?      @map("acknowledged_at")

  @@unique([jobDescriptionId, userId])
  @@index([userId, acknowledgedAt])
  @@index([tenantId])
  @@map("job_description_assignment")
}

model SignatureRecord {
  tenantId     String?  @map("tenant_id")
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  user         User     @relation("UserSignatures", fields: [userId], references: [id], onDelete: Cascade)
  entityType   String   @map("entity_type") // STAFF_DOCUMENT | LEAVE_REQUEST | TIMESHEET | ANNUAL_PLAN | RECRUITMENT_REQUEST | JOB_DESCRIPTION | OFFBOARDING
  entityId     String   @map("entity_id")
  decision     String // SUBMITTED | APPROVED | REJECTED | SIGNED | ACKNOWLEDGED
  signedName   String   @map("signed_name")
  signatureUrl String?  @map("signature_url")
  initialsUrl  String?  @map("initials_url")
  initialsText String?  @map("initials_text")
  note         String?
  signedAt     DateTime @default(now()) @map("signed_at")

  @@index([entityType, entityId])
  @@index([userId, signedAt])
  @@index([tenantId])
  @@map("signature_record")
}

// --- OFFBOARDING / EXIT MANAGEMENT ---

model OffboardingCase {
  tenantId               String?           @map("tenant_id")
  id                     String            @id @default(cuid())
  userId                 String            @map("user_id")
  user                   User              @relation("UserOffboarding", fields: [userId], references: [id], onDelete: Cascade)
  initiatedById          String            @map("initiated_by_id")
  initiatedBy            User              @relation("OffboardingInitiator", fields: [initiatedById], references: [id], onDelete: Restrict)
  managerId              String?           @map("manager_id")
  manager                User?             @relation("OffboardingManager", fields: [managerId], references: [id], onDelete: SetNull)
  reason                 String            @default("RESIGNATION") // RESIGNATION | TERMINATION | RETIREMENT | CONTRACT_END | OTHER
  status                 String            @default("INITIATED") // SUBMITTED | INITIATED | IN_PROGRESS | READY_FOR_EXIT | COMPLETED | WITHDRAWN
  noticeDate             DateTime?         @map("notice_date")
  lastWorkingDay         DateTime          @map("last_working_day")
  // Employee-filed resignation: the snapshot of the HR notice period applied at
  // submission, plus the note and the moment it was filed.
  resignationSubmittedAt DateTime?         @map("resignation_submitted_at")
  resignationNote        String?           @map("resignation_note")
  noticePeriodDays       Int?              @map("notice_period_days")
  acceptedAt             DateTime?         @map("accepted_at")
  exitInterviewAt        DateTime?         @map("exit_interview_at")
  exitInterviewNotes     String?           @map("exit_interview_notes")
  handoverNotes          String?           @map("handover_notes")
  finalSettlementAmount  Float?            @map("final_settlement_amount")
  settlementStatus       String            @default("PENDING") @map("settlement_status") // PENDING | CALCULATED | PAID
  eligibleForRehire      Boolean?          @map("eligible_for_rehire")
  employeeAcknowledgedAt DateTime?         @map("employee_acknowledged_at")
  hrApprovedAt           DateTime?         @map("hr_approved_at")
  completedAt            DateTime?         @map("completed_at")
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @updatedAt @map("updated_at")
  tasks                  OffboardingTask[]

  @@index([userId, status])
  @@index([status, lastWorkingDay])
  @@index([tenantId])
  @@map("offboarding_case")
}

model OffboardingTask {
  tenantId    String?         @map("tenant_id")
  id          String          @id @default(cuid())
  caseId      String          @map("case_id")
  case        OffboardingCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  title       String
  category    String          @default("GENERAL") // HANDOVER | ASSETS | ACCESS | FINANCE | HR | EXIT
  owner       String          @default("HR")
  dueAt       DateTime?       @map("due_at")
  completedAt DateTime?       @map("completed_at")
  completedBy String?         @map("completed_by")
  notes       String?
  sortOrder   Int             @default(0) @map("sort_order")

  @@index([caseId, sortOrder])
  @@index([tenantId])
  @@map("offboarding_task")
}

// --- PERFORMANCE MANAGEMENT ---

model Appraisal {
  tenantId       String?         @map("tenant_id")
  id             String          @id @default(cuid())
  userId         String          @map("user_id")
  user           User            @relation("UserAppraisals", fields: [userId], references: [id], onDelete: Cascade)
  cycle          String // e.g. "2026-H2"
  periodLabel    String          @map("period_label")
  periodStart    DateTime        @map("period_start")
  periodEnd      DateTime        @map("period_end")
  status         String          @default("DRAFT") // DRAFT | SELF_SUBMITTED | MANAGER_REVIEWED | COMPLETED
  selfSummary    String?         @map("self_summary")
  managerSummary String?         @map("manager_summary")
  selfRating     Float?          @map("self_rating")
  managerRating  Float?          @map("manager_rating")
  submittedAt    DateTime?       @map("submitted_at")
  reviewedAt     DateTime?       @map("reviewed_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  items          AppraisalItem[]

  @@unique([userId, cycle])
  @@index([tenantId])
  @@map("appraisal")
}

model AppraisalItem {
  tenantId     String?   @map("tenant_id")
  id           String    @id @default(cuid())
  appraisalId  String    @map("appraisal_id")
  appraisal    Appraisal @relation(fields: [appraisalId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  category     String?
  weight       Int       @default(20)
  maxScore     Float     @default(5) @map("max_score")
  selfScore    Float?    @map("self_score")
  managerScore Float?    @map("manager_score")
  comment      String?
  sortOrder    Int       @default(0) @map("sort_order")

  @@index([tenantId])
  @@map("appraisal_item")
}

// HR-configurable appraisal framework. Changes apply to newly opened cycles;
// existing appraisal items keep their snapshot so historic scores never move.
model AppraisalCriterion {
  tenantId            String?  @map("tenant_id")
  id                  String   @id @default(cuid())
  title               String
  description         String?
  category            String?  @default("Core")
  weight              Int      @default(20)
  maxScore            Float    @default(5) @map("max_score")
  guidance            String?
  appliesToDepartment String?  @map("applies_to_department")
  sortOrder           Int      @default(0) @map("sort_order")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@index([tenantId])
  @@map("appraisal_criterion")
}

// ============================================================
// FLEET & TRANSPORT
// Vehicles, drivers, requests (2-stage approval), ride-service
// alternative, and settings. Added for Ethio-Biopharma.
// ============================================================

model Vehicle {
  tenantId         String?   @map("tenant_id")
  id               String    @id @default(cuid())
  vehicleCode      String    @unique // "V001"
  type             String // Sedan | 4x4 | Minibus | Ambulance | Truck | Motorcycle
  licensePlate     String    @unique
  capacity         Int
  assignedDriverId String?   @map("assigned_driver_id")
  assignedDriver   Driver?   @relation("VehicleDriver", fields: [assignedDriverId], references: [id], onDelete: SetNull)
  status           String    @default("Available") // Available | In Use | Under Maintenance | Unavailable
  lastMaintenance  DateTime? @map("last_maintenance")
  nextMaintenance  DateTime? @map("next_maintenance")
  odometer         Float?
  fuelType         String?   @map("fuel_type") // Petrol | Diesel | Electric | Hybrid
  remarks          String?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  requests           VehicleRequest[]
  fuelLogs           FuelLog[]
  maintenanceRecords MaintenanceRecord[]
  spareParts         SparePartRecord[]
  tyres              TyreRecord[]

  @@index([status])
  @@index([tenantId])
  @@map("vehicle")
}

model Driver {
  tenantId      String?   @map("tenant_id")
  id            String    @id @default(cuid())
  driverCode    String    @unique // "D001"
  name          String
  phone         String
  email         String?
  userId        String?   @unique @map("user_id") // optional link to User (hybrid Q6c)
  user          User?     @relation("DriverUser", fields: [userId], references: [id], onDelete: SetNull)
  status        String    @default("Available") // Available | On Leave | Suspended
  licenseExpiry DateTime? @map("license_expiry")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  vehicles Vehicle[]        @relation("VehicleDriver")
  requests VehicleRequest[] @relation("VehicleRequestDriver")
  fuelLogs FuelLog[]        @relation("FuelLogDriver")

  @@index([status])
  @@index([tenantId])
  @@map("driver")
}

model VehicleRequest {
  tenantId             String?   @map("tenant_id")
  id                   String    @id @default(cuid())
  requestCode          String    @unique // "REQ-20261110-0001"
  requesterId          String    @map("requester_id")
  requester            User      @relation("VehicleRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  requestType          String    @map("request_type") // In-Town | Field
  tripPurpose          String    @map("trip_purpose")
  department           String?
  division             String?
  vehicleTypePreferred String?   @map("vehicle_type_preferred")
  passengers           Int       @default(1)
  departureDate        DateTime  @map("departure_date")
  returnDate           DateTime  @map("return_date")
  departureTime        String    @map("departure_time")
  returnTime           String?   @map("return_time")
  pickupLocation       String    @map("pickup_location")
  destination          String
  distance             Float?
  odometerStart        Float?    @map("odometer_start")
  odometerEnd          Float?    @map("odometer_end")
  status               String    @default("PENDING")
  // PENDING | SUPERVISOR_APPROVED | FLEET_APPROVED | ASSIGNED | IN_PROGRESS | COMPLETED | REJECTED | CANCELLED | EXPIRED
  supervisorId         String?   @map("supervisor_id")
  supervisor           User?     @relation("VehicleRequestSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  fleetApproverId      String?   @map("fleet_approver_id")
  fleetApprover        User?     @relation("VehicleRequestFleetApprover", fields: [fleetApproverId], references: [id], onDelete: SetNull)
  vehicleId            String?   @map("vehicle_id")
  vehicle              Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driverId             String?   @map("driver_id")
  driver               Driver?   @relation("VehicleRequestDriver", fields: [driverId], references: [id], onDelete: SetNull)
  rejectionReason      String?   @map("rejection_reason")
  gatePassNo           String?   @map("gate_pass_no")
  gatePassSentAt       DateTime? @map("gate_pass_sent_at")
  remarks              String?
  requestedAt          DateTime  @default(now()) @map("requested_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  rideRequests RideRequest[]

  @@index([status, departureDate])
  @@index([requesterId, requestedAt])
  @@index([supervisorId, status])
  @@index([tenantId])
  @@map("vehicle_request")
}

model RideProvider {
  tenantId     String?  @map("tenant_id")
  id           String   @id @default(cuid())
  name         String   @unique // "Ride", "ZayRide", "Feres", etc.
  contactName  String?  @map("contact_name")
  contactPhone String?  @map("contact_phone")
  contactEmail String?  @map("contact_email")
  pricingNote  String?  @map("pricing_note")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  rideRequests RideRequest[]

  @@index([tenantId])
  @@map("ride_provider")
}

model RideRequest {
  tenantId               String?         @map("tenant_id")
  id                     String          @id @default(cuid())
  requestCode            String          @unique // "RIDE-20261110-0001"
  requesterId            String          @map("requester_id")
  requester              User            @relation("RideRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  linkedVehicleRequestId String?         @map("linked_vehicle_request_id")
  linkedVehicleRequest   VehicleRequest? @relation(fields: [linkedVehicleRequestId], references: [id], onDelete: SetNull)
  tripPurpose            String          @map("trip_purpose")
  pickupLocation         String          @map("pickup_location")
  destination            String
  departureDate          DateTime        @map("departure_date")
  departureTime          String          @map("departure_time")
  returnTime             String?         @map("return_time")
  passengers             Int             @default(1)
  providerId             String?         @map("provider_id")
  provider               RideProvider?   @relation(fields: [providerId], references: [id], onDelete: SetNull)
  estimatedFare          Float?          @map("estimated_fare")
  actualFare             Float?          @map("actual_fare")
  currency               String          @default("ETB")
  receiptUrl             String?         @map("receipt_url")
  status                 String          @default("PENDING")
  // PENDING | SUPERVISOR_APPROVED | FLEET_APPROVED | ASSIGNED | COMPLETED | REJECTED | CANCELLED
  supervisorId           String?         @map("supervisor_id")
  supervisor             User?           @relation("RideSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  approverId             String?         @map("approver_id")
  approver               User?           @relation("RideApprover", fields: [approverId], references: [id], onDelete: SetNull)
  rejectionReason        String?         @map("rejection_reason")
  remarks                String?
  requestedAt            DateTime        @default(now()) @map("requested_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")

  @@index([status, departureDate])
  @@index([requesterId, requestedAt])
  @@index([supervisorId, status])
  @@index([tenantId])
  @@map("ride_request")
}

model FleetSetting {
  tenantId    String?  @map("tenant_id")
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("fleet_setting")
}

// ============================================================
// FLEET COST CONTROL
// Fuel, scheduled maintenance, spare parts and tyre lifecycle,
// all costed per vehicle and rollable into one total cost of ownership.
// ============================================================

model FuelLog {
  tenantId     String?  @map("tenant_id")
  id           String   @id @default(cuid())
  vehicleId    String   @map("vehicle_id")
  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driverId     String?  @map("driver_id")
  driver       Driver?  @relation("FuelLogDriver", fields: [driverId], references: [id], onDelete: SetNull)
  date         DateTime
  odometer     Float?
  litres       Float
  unitCost     Float    @map("unit_cost")
  totalCost    Float    @map("total_cost")
  fuelType     String?  @map("fuel_type")
  station      String?
  reference    String?
  receiptUrl   String?  @map("receipt_url")
  notes        String?
  recordedById String?  @map("recorded_by_id")
  recordedBy   String?  @map("recorded_by")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([vehicleId, date])
  @@index([date])
  @@index([tenantId])
  @@map("fleet_fuel_log")
}

model MaintenanceRecord {
  tenantId            String?   @map("tenant_id")
  id                  String    @id @default(cuid())
  vehicleId           String    @map("vehicle_id")
  vehicle             Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  title               String
  type                String    @default("Scheduled") // Scheduled | Repair | Inspection | Tyre service
  status              String    @default("Scheduled") // Scheduled | In Progress | Completed | Cancelled
  scheduledDate       DateTime? @map("scheduled_date")
  completedDate       DateTime? @map("completed_date")
  odometer            Float?
  vendor              String?
  laborCost           Float     @default(0) @map("labor_cost")
  partsCost           Float     @default(0) @map("parts_cost")
  totalCost           Float     @default(0) @map("total_cost")
  invoiceNo           String?   @map("invoice_no")
  nextServiceDate     DateTime? @map("next_service_date")
  nextServiceOdometer Float?    @map("next_service_odometer")
  notes               String?
  recordedById        String?   @map("recorded_by_id")
  recordedBy          String?   @map("recorded_by")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([vehicleId, scheduledDate])
  @@index([status, scheduledDate])
  @@index([tenantId])
  @@map("fleet_maintenance")
}

model SparePartRecord {
  tenantId      String?  @map("tenant_id")
  id            String   @id @default(cuid())
  vehicleId     String   @map("vehicle_id")
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  date          DateTime
  partName      String   @map("part_name")
  partNumber    String?  @map("part_number")
  quantity      Float    @default(1)
  unitCost      Float    @map("unit_cost")
  totalCost     Float    @map("total_cost")
  supplier      String?
  odometer      Float?
  maintenanceId String?  @map("maintenance_id")
  notes         String?
  recordedById  String?  @map("recorded_by_id")
  recordedBy    String?  @map("recorded_by")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([vehicleId, date])
  @@index([tenantId])
  @@map("fleet_spare_part")
}

model TyreRecord {
  tenantId     String?  @map("tenant_id")
  id           String   @id @default(cuid())
  vehicleId    String   @map("vehicle_id")
  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  date         DateTime
  position     String // FL | FR | RL | RR | Spare | Set
  brand        String?
  size         String?
  serialNumber String?  @map("serial_number")
  quantity     Float    @default(1)
  unitCost     Float    @map("unit_cost")
  totalCost    Float    @map("total_cost")
  odometer     Float?
  action       String   @default("Fitted") // Fitted | Rotated | Replaced | Retired
  notes        String?
  recordedById String?  @map("recorded_by_id")
  recordedBy   String?  @map("recorded_by")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([vehicleId, date])
  @@index([position])
  @@index([tenantId])
  @@map("fleet_tyre")
}

// One row per destination per news item. The publisher updates status and
// retry history, so a failed Facebook or LinkedIn call never blocks the news
// article from being published on the website.
model SocialPost {
  tenantId     String?   @map("tenant_id")
  id           String    @id @default(cuid())
  newsId       String    @map("news_id")
  news         News      @relation(fields: [newsId], references: [id], onDelete: Cascade)
  channel      String // facebook | linkedin | x | telegram | webhook
  status       String    @default("QUEUED") // QUEUED | SENDING | SENT | FAILED | SKIPPED
  caption      String?
  externalId   String?   @map("external_id")
  externalUrl  String?   @map("external_url")
  error        String?
  attempts     Int       @default(0)
  scheduledFor DateTime  @default(now()) @map("scheduled_for")
  sentAt       DateTime? @map("sent_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@unique([newsId, channel])
  @@index([status, scheduledFor])
  @@index([tenantId])
  @@map("social_post")
}

// ============================================================
// QMS — QUALITY MANAGEMENT SYSTEM
// WHO-aligned document control module.
// ============================================================

model QmsDocument {
  tenantId        String?       @map("tenant_id")
  id              String        @id @default(cuid())
  code            String // "SOP-QA-001" (document family; unique per version)
  title           String
  titleAm         String?       @map("title_am")
  description     String?
  category        String // SOP | Specification | Protocol | Record | Policy | Work Instruction | Form
  department      String? // QA | Production | QC | Warehouse | Engineering | Regulatory | HR | IT
  version         String        @default("1.0") // "1.0", "2.1"
  status          String        @default("DRAFT") // DRAFT | IN_REVIEW | APPROVED | SUPERSEDED | OBSOLETE
  ownerId         String        @map("owner_id")
  owner           User          @relation("QmsDocumentOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  reviewerId      String?       @map("reviewer_id")
  reviewer        User?         @relation("QmsDocumentReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  approverId      String?       @map("approver_id")
  approver        User?         @relation("QmsDocumentApprover", fields: [approverId], references: [id], onDelete: SetNull)
  fileUrl         String?       @map("file_url")
  fileName        String?       @map("file_name")
  fileSize        Int?          @map("file_size")
  effectiveDate   DateTime?     @map("effective_date")
  reviewDueAt     DateTime?     @map("review_due_at")
  approvedAt      DateTime?     @map("approved_at")
  supersededAt    DateTime?     @map("superseded_at")
  supersededById  String?       @map("superseded_by_id")
  supersededBy    QmsDocument?  @relation("QmsSupersession", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes      QmsDocument[] @relation("QmsSupersession")
  changeSummary   String?       @map("change_summary")
  rejectionReason String?       @map("rejection_reason")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@unique([code, version])
  @@index([code])
  @@index([status, category])
  @@index([department])
  @@index([ownerId])
  @@index([effectiveDate])
  @@index([tenantId])
  @@map("qms_document")
}

// ============================================================
// QMS — DEVIATIONS, CAPA AND CHANGE CONTROL
// Completes the WHO quality-event lifecycle beyond document control.
// ============================================================

model QmsDeviation {
  tenantId        String?   @map("tenant_id")
  id              String    @id @default(cuid())
  code            String    @unique
  title           String
  description     String
  category        String    @default("Process") // Product | Process | Equipment | Document | Supplier | Other
  severity        String    @default("Minor") // Critical | Major | Minor
  source          String    @default("Internal") // Internal | Audit | Complaint | Supplier | Regulatory | Customer
  department      String?
  detectedAt      DateTime  @default(now()) @map("detected_at")
  reportedById    String    @map("reported_by_id")
  reportedBy      User      @relation("QmsDeviationReporter", fields: [reportedById], references: [id], onDelete: Restrict)
  ownerId         String    @map("owner_id")
  owner           User      @relation("QmsDeviationOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  status          String    @default("OPEN") // OPEN | UNDER_INVESTIGATION | CLOSED
  immediateAction String?   @map("immediate_action")
  rootCause       String?   @map("root_cause")
  investigation   String?
  closureNotes    String?   @map("closure_notes")
  dueAt           DateTime? @map("due_at")
  closedAt        DateTime? @map("closed_at")
  closedById      String?   @map("closed_by_id")
  closedBy        User?     @relation("QmsDeviationCloser", fields: [closedById], references: [id], onDelete: SetNull)
  capas           QmsCapa[] @relation("QmsCapaDeviation")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([status, severity])
  @@index([department])
  @@index([ownerId])
  @@index([detectedAt])
  @@index([tenantId])
  @@map("qms_deviation")
}

model QmsCapa {
  tenantId           String?       @map("tenant_id")
  id                 String        @id @default(cuid())
  code               String        @unique
  title              String
  type               String        @default("Corrective") // Corrective | Preventive
  sourceType         String        @default("Deviation") // Deviation | Change | Audit | Complaint | Other
  sourceRef          String?       @map("source_ref")
  description        String
  rootCause          String?       @map("root_cause")
  actionPlan         String?       @map("action_plan")
  department         String?
  ownerId            String        @map("owner_id")
  owner              User          @relation("QmsCapaOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  status             String        @default("OPEN") // OPEN | IN_PROGRESS | PENDING_VERIFICATION | CLOSED
  dueAt              DateTime?     @map("due_at")
  effectivenessCheck String?       @map("effectiveness_check")
  verifiedById       String?       @map("verified_by_id")
  verifiedBy         User?         @relation("QmsCapaVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt         DateTime?     @map("verified_at")
  closedAt           DateTime?     @map("closed_at")
  deviationId        String?       @map("deviation_id")
  deviation          QmsDeviation? @relation("QmsCapaDeviation", fields: [deviationId], references: [id], onDelete: SetNull)
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  @@index([status, dueAt])
  @@index([ownerId])
  @@index([deviationId])
  @@index([tenantId])
  @@map("qms_capa")
}

model QmsChangeControl {
  tenantId           String?   @map("tenant_id")
  id                 String    @id @default(cuid())
  code               String    @unique
  title              String
  description        String
  reason             String
  category           String    @default("Process") // Document | Process | Equipment | Facility | System | Supplier
  riskLevel          String    @default("Medium") // High | Medium | Low
  department         String?
  ownerId            String    @map("owner_id")
  owner              User      @relation("QmsChangeOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  status             String    @default("DRAFT") // DRAFT | IN_REVIEW | APPROVED | IMPLEMENTED | CLOSED | REJECTED
  impactAssessment   String?   @map("impact_assessment")
  implementationPlan String?   @map("implementation_plan")
  effectiveDate      DateTime? @map("effective_date")
  relatedDocument    String?   @map("related_document")
  approvedById       String?   @map("approved_by_id")
  approvedBy         User?     @relation("QmsChangeApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt         DateTime? @map("approved_at")
  implementedAt      DateTime? @map("implemented_at")
  closedAt           DateTime? @map("closed_at")
  closureNotes       String?   @map("closure_notes")
  rejectionReason    String?   @map("rejection_reason")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@index([status, riskLevel])
  @@index([department])
  @@index([ownerId])
  @@index([effectiveDate])
  @@index([tenantId])
  @@map("qms_change_control")
}

// ============================================================
// SaaS / MULTI-TENANCY (S1 - schema additions, no migration yet)
// ============================================================

model Tenant {
  id                   String    @id @default(cuid())
  slug                 String    @unique
  name                 String
  type                 String    @default("PROFIT") // PROFIT | NON_PROFIT
  legalName            String?   @map("legal_name")
  taxId                String?   @map("tax_id")
  country              String?   @default("ET")
  timezone             String    @default("Africa/Addis_Ababa")
  primaryEmail         String    @map("primary_email")
  primaryPhone         String?   @map("primary_phone")
  status               String    @default("TRIAL") // TRIAL | ACTIVE | PAST_DUE | SUSPENDED | CANCELLED
  trialEndsAt          DateTime? @map("trial_ends_at")
  stripeCustomerId     String?   @unique @map("stripe_customer_id")
  stripeSubscriptionId String?   @unique @map("stripe_subscription_id")
  onboardingComplete   Boolean   @default(false) @map("onboarding_complete")
  // Optional per-tenant module override. Empty => inherit subscription plan modules.
  enabledModules       String[]  @default([]) @map("enabled_modules")
  // Foundational onboarding/profile context
  profile              Json?
  industryType         String?   @map("industry_type")
  orgSize              String?   @map("org_size")
  primaryMarket        String?   @map("primary_market")
  languages            String[]  @default(["en"])
  defaultTimezone      String    @default("Africa/Addis_Ababa") @map("default_timezone")
  fiscalYearStart      Int       @default(1) @map("fiscal_year_start")
  currency             String    @default("ETB")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  users              User[]
  subscriptionPlan   SubscriptionPlan?       @relation(fields: [subscriptionPlanId], references: [id])
  subscriptionPlanId String?                 @map("subscription_plan_id")
  settings           TenantSetting[]
  customFields       CustomFieldDefinition[]

  @@map("tenant")
}

model SubscriptionPlan {
  id                   String   @id @default(cuid())
  code                 String   @unique // STARTER, PROFESSIONAL, ENTERPRISE, NONPROFIT_BASIC
  name                 String
  description          String?
  priceMonthly         Float    @map("price_monthly")
  priceYearly          Float    @map("price_yearly")
  currency             String   @default("USD")
  trialDays            Int      @default(14) @map("trial_days")
  enabledModules       String[] @default([]) @map("enabled_modules")
  defaultIndustries    String[] @default([]) @map("default_industries")
  maxUsers             Int      @default(10) @map("max_users")
  maxStorageGb         Int      @default(5) @map("max_storage_gb")
  forNonProfit         Boolean  @default(false) @map("for_non_profit")
  isActive             Boolean  @default(true) @map("is_active")
  stripePriceIdMonthly String?  @unique @map("stripe_price_id_monthly")
  stripePriceIdYearly  String?  @unique @map("stripe_price_id_yearly")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  tenants Tenant[]

  @@map("subscription_plan")
}

model TenantSetting {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key       String
  value     Json
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, key])
  @@map("tenant_setting")
}

model CustomFieldDefinition {
  id           String             @id @default(cuid())
  tenantId     String             @map("tenant_id")
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entityType   String             @map("entity_type")
  fieldKey     String             @map("field_key")
  fieldLabel   String             @map("field_label")
  fieldLabelAm String?            @map("field_label_am")
  fieldType    String             @map("field_type") // text | number | date | select | textarea | boolean
  options      String[]           @default([])
  required     Boolean            @default(false)
  placeholder  String?
  helpText     String?            @map("help_text")
  sortOrder    Int                @default(0) @map("sort_order")
  isActive     Boolean            @default(true) @map("is_active")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  values       CustomFieldValue[]

  @@unique([tenantId, entityType, fieldKey])
  @@index([tenantId, entityType, isActive, sortOrder])
  @@map("custom_field_definition")
}

model CustomFieldValue {
  id           String                @id @default(cuid())
  tenantId     String                @map("tenant_id")
  definitionId String                @map("definition_id")
  definition   CustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  entityType   String                @map("entity_type")
  entityId     String                @map("entity_id")
  value        Json?
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  @@unique([definitionId, entityId])
  @@index([tenantId, entityType, entityId])
  @@map("custom_field_value")
}

model Invoice {
  id              String    @id @default(cuid())
  tenantId        String    @map("tenant_id")
  stripeInvoiceId String    @unique @map("stripe_invoice_id")
  amountDue       Float     @map("amount_due")
  amountPaid      Float     @default(0) @map("amount_paid")
  currency        String    @default("USD")
  status          String
  periodStart     DateTime  @map("period_start")
  periodEnd       DateTime  @map("period_end")
  invoicePdfUrl   String?   @map("invoice_pdf_url")
  paidAt          DateTime? @map("paid_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([tenantId, status])
  @@map("invoice")
}

// ============================================================
// TIER 1 — PROCUREMENT & VENDOR MANAGEMENT (MVP)
// ============================================================

model Vendor {
  id             String          @id @default(cuid())
  tenantId       String          @map("tenant_id")
  code           String?
  name           String
  contactName    String?         @map("contact_name")
  email          String?
  phone          String?
  address        String?
  category       String?
  status         String          @default("ACTIVE") // ACTIVE | INACTIVE | BLACKLISTED
  rating         Int?            @default(0)
  paymentTerms   String?         @map("payment_terms")
  notes          String?
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  purchaseOrders PurchaseOrder[]

  @@index([tenantId, status])
  @@index([tenantId, name])
  @@map("vendor")
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  tenantId    String              @map("tenant_id")
  poNumber    String              @map("po_number")
  vendorId    String              @map("vendor_id")
  vendor      Vendor              @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  status      String              @default("DRAFT") // DRAFT | SUBMITTED | APPROVED | ORDERED | RECEIVED | CLOSED | CANCELLED
  orderDate   DateTime?           @map("order_date")
  expectedAt  DateTime?           @map("expected_at")
  currency    String              @default("ETB")
  subtotal    Float               @default(0)
  tax         Float               @default(0)
  total       Float               @default(0)
  notes       String?
  requestedBy String?             @map("requested_by")
  approvedBy  String?             @map("approved_by")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  items       PurchaseOrderItem[]

  @@unique([tenantId, poNumber])
  @@index([tenantId, status])
  @@index([tenantId, vendorId])
  @@map("purchase_order")
}

model PurchaseOrderItem {
  id          String        @id @default(cuid())
  tenantId    String        @map("tenant_id")
  orderId     String        @map("order_id")
  order       PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  description String
  sku         String?
  quantity    Float         @default(1)
  unit        String?       @default("unit")
  unitPrice   Float         @default(0) @map("unit_price")
  total       Float         @default(0)
  receivedQty Float         @default(0) @map("received_qty")

  @@index([tenantId, orderId])
  @@map("purchase_order_item")
}

// ============================================================
// TIER 1 — INVENTORY & WAREHOUSE MANAGEMENT (WMS, MVP)
// ============================================================

model Warehouse {
  id        String          @id @default(cuid())
  tenantId  String          @map("tenant_id")
  code      String
  name      String
  location  String?
  type      String?         @default("MAIN") // MAIN | STORE | DISTRIBUTION
  status    String          @default("ACTIVE")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  items     InventoryItem[]
  movements StockMovement[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("warehouse")
}

model InventoryItem {
  id           String          @id @default(cuid())
  tenantId     String          @map("tenant_id")
  warehouseId  String          @map("warehouse_id")
  warehouse    Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  sku          String
  name         String
  category     String?
  unit         String?         @default("unit")
  quantity     Float           @default(0)
  minLevel     Float           @default(0) @map("min_level")
  reorderPoint Float           @default(0) @map("reorder_point")
  unitCost     Float           @default(0) @map("unit_cost")
  status       String          @default("ACTIVE")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  movements    StockMovement[]

  @@unique([tenantId, warehouseId, sku])
  @@index([tenantId, warehouseId])
  @@index([tenantId, name])
  @@map("inventory_item")
}

model StockMovement {
  id          String        @id @default(cuid())
  tenantId    String        @map("tenant_id")
  warehouseId String        @map("warehouse_id")
  warehouse   Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  itemId      String        @map("item_id")
  item        InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type        String // IN | OUT | ADJUST | TRANSFER
  quantity    Float
  reference   String?
  reason      String?
  performedBy String?       @map("performed_by")
  createdAt   DateTime      @default(now()) @map("created_at")

  @@index([tenantId, warehouseId, createdAt])
  @@index([tenantId, itemId])
  @@map("stock_movement")
}

// ============================================================
// TIER 1 — ACCOUNTING & FINANCIALS (GL/AP/AR, MVP)
// ============================================================

model GLAccount {
  id           String        @id @default(cuid())
  tenantId     String        @map("tenant_id")
  code         String
  name         String
  type         String // ASSET | LIABILITY | EQUITY | REVENUE | EXPENSE
  category     String?
  parentId     String?       @map("parent_id")
  parent       GLAccount?    @relation("GLHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     GLAccount[]   @relation("GLHierarchy")
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  journalLines JournalLine[]

  @@unique([tenantId, code])
  @@index([tenantId, type])
  @@map("gl_account")
}

model JournalEntry {
  id          String        @id @default(cuid())
  tenantId    String        @map("tenant_id")
  entryNo     String        @map("entry_no")
  date        DateTime
  memo        String?
  source      String?       @default("MANUAL")
  status      String        @default("DRAFT") // DRAFT | POSTED | VOID
  totalDebit  Float         @default(0) @map("total_debit")
  totalCredit Float         @default(0) @map("total_credit")
  createdBy   String?       @map("created_by")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  lines       JournalLine[]

  @@unique([tenantId, entryNo])
  @@index([tenantId, date])
  @@index([tenantId, status])
  @@map("journal_entry")
}

model JournalLine {
  id        String       @id @default(cuid())
  tenantId  String       @map("tenant_id")
  entryId   String       @map("entry_id")
  entry     JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId String       @map("account_id")
  account   GLAccount    @relation(fields: [accountId], references: [id], onDelete: Restrict)
  debit     Float        @default(0)
  credit    Float        @default(0)
  memo      String?

  @@index([tenantId, entryId])
  @@index([tenantId, accountId])
  @@map("journal_line")
}

model VendorBill {
  id         String    @id @default(cuid())
  tenantId   String    @map("tenant_id")
  billNo     String    @map("bill_no")
  vendorName String    @map("vendor_name")
  vendorId   String?   @map("vendor_id")
  issueDate  DateTime  @map("issue_date")
  dueDate    DateTime? @map("due_date")
  currency   String    @default("ETB")
  amount     Float
  balance    Float
  status     String    @default("OPEN") // OPEN | PARTIAL | PAID | VOID
  reference  String?
  notes      String?
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, billNo])
  @@index([tenantId, status])
  @@map("vendor_bill")
}

model CustomerInvoice {
  id           String    @id @default(cuid())
  tenantId     String    @map("tenant_id")
  invoiceNo    String    @map("invoice_no")
  customerName String    @map("customer_name")
  issueDate    DateTime  @map("issue_date")
  dueDate      DateTime? @map("due_date")
  currency     String    @default("ETB")
  amount       Float
  balance      Float
  status       String    @default("OPEN") // OPEN | PARTIAL | PAID | VOID
  reference    String?
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, invoiceNo])
  @@index([tenantId, status])
  @@map("customer_invoice")
}

// ============================================================
// TIER 1 — ASSET & MAINTENANCE MANAGEMENT (EAM/CMMS, MVP)
// ============================================================

model Asset {
  id             String                 @id @default(cuid())
  tenantId       String                 @map("tenant_id")
  assetTag       String                 @map("asset_tag")
  name           String
  category       String?
  location       String?
  custodian      String?
  status         String                 @default("ACTIVE") // ACTIVE | IN_MAINTENANCE | RETIRED | DISPOSED
  purchaseDate   DateTime?              @map("purchase_date")
  purchaseCost   Float?                 @map("purchase_cost")
  warrantyExpiry DateTime?              @map("warranty_expiry")
  serialNo       String?                @map("serial_no")
  notes          String?
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")
  workOrders     MaintenanceWorkOrder[]

  @@unique([tenantId, assetTag])
  @@index([tenantId, status])
  @@index([tenantId, category])
  @@map("asset")
}

model MaintenanceWorkOrder {
  id            String    @id @default(cuid())
  tenantId      String    @map("tenant_id")
  workOrderNo   String    @map("work_order_no")
  assetId       String?   @map("asset_id")
  asset         Asset?    @relation(fields: [assetId], references: [id], onDelete: SetNull)
  assetName     String?   @map("asset_name")
  type          String    @default("CORRECTIVE") // PREVENTIVE | CORRECTIVE | INSPECTION
  priority      String    @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  status        String    @default("OPEN") // OPEN | IN_PROGRESS | ON_HOLD | COMPLETED | CANCELLED
  description   String?
  reportedBy    String?   @map("reported_by")
  assignedTo    String?   @map("assigned_to")
  scheduledAt   DateTime? @map("scheduled_at")
  completedAt   DateTime? @map("completed_at")
  laborCost     Float     @default(0) @map("labor_cost")
  partsCost     Float     @default(0) @map("parts_cost")
  downtimeHours Float     @default(0) @map("downtime_hours")
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, workOrderNo])
  @@index([tenantId, status])
  @@index([tenantId, assetId])
  @@map("maintenance_work_order")
}

// ============================================================
// TIER 2 — CRM & SALES / ORDER MANAGEMENT (MVP)
// ============================================================

model CrmAccount {
  id          String       @id @default(cuid())
  tenantId    String       @map("tenant_id")
  name        String
  type        String       @default("CUSTOMER") // CUSTOMER | PROSPECT | PARTNER
  industry    String?
  email       String?
  phone       String?
  owner       String?
  status      String       @default("ACTIVE")
  notes       String?
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  contacts    CrmContact[]
  deals       CrmDeal[]
  orders      SalesOrder[]

  @@index([tenantId, type])
  @@index([tenantId, name])
  @@map("crm_account")
}

model CrmContact {
  id        String      @id @default(cuid())
  tenantId  String      @map("tenant_id")
  accountId String?     @map("account_id")
  account   CrmAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  name      String
  email     String?
  phone     String?
  title     String?
  notes     String?
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@index([tenantId, accountId])
  @@map("crm_contact")
}

model CrmDeal {
  id          String      @id @default(cuid())
  tenantId    String      @map("tenant_id")
  accountId   String?     @map("account_id")
  account     CrmAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  title       String
  stage       String      @default("LEAD") // LEAD | QUALIFIED | PROPOSAL | NEGOTIATION | WON | LOST
  value       Float       @default(0)
  currency    String      @default("ETB")
  probability Int         @default(0)
  owner       String?
  closeDate   DateTime?   @map("close_date")
  notes       String?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@index([tenantId, stage])
  @@index([tenantId, accountId])
  @@map("crm_deal")
}

model SalesOrder {
  id           String      @id @default(cuid())
  tenantId     String      @map("tenant_id")
  orderNo      String      @map("order_no")
  accountId    String?     @map("account_id")
  account      CrmAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  customerName String?     @map("customer_name")
  status       String      @default("DRAFT") // DRAFT | CONFIRMED | FULFILLED | CANCELLED
  orderDate    DateTime    @default(now()) @map("order_date")
  total        Float       @default(0)
  currency     String      @default("ETB")
  notes        String?
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@unique([tenantId, orderNo])
  @@index([tenantId, status])
  @@map("sales_order")
}

// ============================================================
// TIER 2 — EXTERNAL PORTALS (MVP)
// ============================================================

model PortalRequest {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  portalType  String   @map("portal_type") // CUSTOMER | PARTNER | VENDOR
  requestNo   String   @map("request_no")
  subject     String
  requester   String?
  company     String?
  status      String   @default("OPEN") // OPEN | IN_REVIEW | APPROVED | REJECTED | CLOSED
  priority    String   @default("MEDIUM")
  description String?
  response    String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, requestNo])
  @@index([tenantId, portalType, status])
  @@map("portal_request")
}

// ============================================================
// TIER 2 — HELPDESK & ITSM (MVP)
// ============================================================

model SupportTicket {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  ticketNo    String    @map("ticket_no")
  subject     String
  description String?
  requester   String?
  assignee    String?
  category    String?
  priority    String    @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  status      String    @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED | CLOSED
  dueAt       DateTime? @map("due_at")
  resolvedAt  DateTime? @map("resolved_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, ticketNo])
  @@index([tenantId, status])
  @@index([tenantId, priority])
  @@map("support_ticket")
}

// ============================================================
// TIER 2 — DMS & RECORDS (MVP)
// ============================================================

model DmsRecord {
  id            String    @id @default(cuid())
  tenantId      String    @map("tenant_id")
  recordNo      String    @map("record_no")
  title         String
  category      String?
  folder        String?
  version       String    @default("1.0")
  status        String    @default("ACTIVE") // DRAFT | ACTIVE | ARCHIVED | DISPOSED
  owner         String?
  tags          String[]  @default([])
  fileName      String?   @map("file_name")
  fileUrl       String?   @map("file_url")
  retentionUntil DateTime? @map("retention_until")
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, recordNo])
  @@index([tenantId, status])
  @@index([tenantId, category])
  @@map("dms_record")
}

// ============================================================
// TIER 3 — GRC, RISK & AUDIT (MVP)
// ============================================================

model RiskItem {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  riskCode    String    @map("risk_code")
  title       String
  category    String?
  owner       String?
  likelihood  Int       @default(1) // 1-5
  impact      Int       @default(1) // 1-5
  score       Int       @default(1)
  status      String    @default("OPEN") // OPEN | MITIGATING | ACCEPTED | CLOSED
  mitigation  String?
  dueDate     DateTime? @map("due_date")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, riskCode])
  @@index([tenantId, status])
  @@map("risk_item")
}

model ComplianceItem {
  id           String    @id @default(cuid())
  tenantId     String    @map("tenant_id")
  controlCode  String    @map("control_code")
  title        String
  framework    String?
  owner        String?
  status       String    @default("PENDING") // PENDING | COMPLIANT | NON_COMPLIANT | IN_REVIEW
  evidence     String?
  lastReviewAt DateTime? @map("last_review_at")
  nextReviewAt DateTime? @map("next_review_at")
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, controlCode])
  @@index([tenantId, status])
  @@map("compliance_item")
}

model AuditFinding {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  findingNo   String    @map("finding_no")
  auditName   String    @map("audit_name")
  title       String
  severity    String    @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  status      String    @default("OPEN") // OPEN | IN_PROGRESS | REMEDIATED | CLOSED
  owner       String?
  dueDate     DateTime? @map("due_date")
  description String?
  actionPlan  String?   @map("action_plan")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, findingNo])
  @@index([tenantId, status])
  @@map("audit_finding")
}

// ============================================================
// TIER 3 — BI & ADVANCED ANALYTICS (MVP)
