  title              String
  department         String
  summary            String?
  description        String?
  requirements       String?
  responsibilities   String?
  location           String?             @default("Kilinto, Addis Ababa")
  employmentType     String?             @default("FULL_TIME") // FULL_TIME | PART_TIME | CONTRACT | INTERNSHIP
  openings           Int                 @default(1)
  status             String              @default("DRAFT") // DRAFT | OPEN | CLOSED | FILLED
  closesAt           DateTime?
  publishedAt        DateTime?
  targetHire         DateTime?
  createdAt          DateTime            @default(now())
  applicants         Applicant[]
