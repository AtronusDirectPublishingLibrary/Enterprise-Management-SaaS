model BiReport {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  code        String
  name        String
  category    String?
  description String?
  dataset     String?
  config      Json?
  owner       String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, code])
  @@index([tenantId, category])
  @@map("bi_report")
}

// ============================================================
// TIER 3 — RESOURCE & CAPACITY, CONTRACTS, EHS (MVP)
// ============================================================

model ResourceAllocation {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  resource    String
  role        String?
  project     String?
  allocation  Int       @default(100) // percent
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  status      String    @default("PLANNED") // PLANNED | ACTIVE | COMPLETED
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([tenantId, status])
  @@index([tenantId, resource])
  @@map("resource_allocation")
}

model ContractRecord {
  id            String    @id @default(cuid())
  tenantId      String    @map("tenant_id")
  contractNo    String    @map("contract_no")
  title         String
  party         String?
  type          String?
  value         Float     @default(0)
  currency      String    @default("ETB")
  status        String    @default("DRAFT") // DRAFT | ACTIVE | EXPIRED | TERMINATED
  startDate     DateTime? @map("start_date")
  endDate       DateTime? @map("end_date")
  renewalDate   DateTime? @map("renewal_date")
  owner         String?
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, contractNo])
  @@index([tenantId, status])
  @@map("contract_record")
}

model SafetyIncident {
  id           String    @id @default(cuid())
  tenantId     String    @map("tenant_id")
  incidentNo   String    @map("incident_no")
  title        String
  type         String?
  severity     String    @default("LOW") // LOW | MEDIUM | HIGH | CRITICAL
  status       String    @default("REPORTED") // REPORTED | INVESTIGATING | RESOLVED | CLOSED
  location     String?
  occurredAt   DateTime? @map("occurred_at")
  reportedBy   String?   @map("reported_by")
  description  String?
  corrective   String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, incidentNo])
  @@index([tenantId, status])
  @@map("safety_incident")
}
